<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Department Report: donor scoping via grant_id.donor_id -->
    <record id="rule_arcs_deptrep_donor_officer_scope" model="ir.rule">
        <field name="name">arcs.department.report — Donor Officer sees only Managed Donors</field>
        <field name="model_id" ref="model_arcs_department_report"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_donor_officer'))]"/>
        <field name="domain_force">[('grant_id.donor_id', 'in', user.arcs_donor_ids.ids)]</field>
    </record>
    <record id="rule_arcs_deptrep_donor_officer_admin_bypass" model="ir.rule">
        <field name="name">arcs.department.report — System Admin unrestricted</field>
        <field name="model_id" ref="model_arcs_department_report"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_system_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Donor Report: donor scoping via its own stored donor_id -->
    <record id="rule_arcs_donorrep_donor_officer_scope" model="ir.rule">
        <field name="name">arcs.donor.report — Donor Officer sees only Managed Donors</field>
        <field name="model_id" ref="model_arcs_donor_report"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_donor_officer'))]"/>
        <field name="domain_force">[('donor_id', 'in', user.arcs_donor_ids.ids)]</field>
    </record>
    <record id="rule_arcs_donorrep_donor_officer_admin_bypass" model="ir.rule">
        <field name="name">arcs.donor.report — System Admin unrestricted</field>
        <field name="model_id" ref="model_arcs_donor_report"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_system_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Report Template: same general-or-own read / own-only write split as
         Compliance Checklist, since templates can also be donor-agnostic. -->
    <record id="rule_arcs_rtemplate_donor_officer_read" model="ir.rule">
        <field name="name">arcs.report.template — Donor Officer read general + own</field>
        <field name="model_id" ref="model_arcs_report_template"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_donor_officer'))]"/>
        <field name="domain_force">
            ['|', ('donor_id', '=', False), ('donor_id', 'in', user.arcs_donor_ids.ids)]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_arcs_rtemplate_donor_officer_write" model="ir.rule">
        <field name="name">arcs.report.template — Donor Officer write own only</field>
        <field name="model_id" ref="model_arcs_report_template"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_donor_officer'))]"/>
        <field name="domain_force">[('donor_id', 'in', user.arcs_donor_ids.ids)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_arcs_rtemplate_donor_officer_admin_bypass" model="ir.rule">
        <field name="name">arcs.report.template — System Admin unrestricted</field>
        <field name="model_id" ref="model_arcs_report_template"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_system_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
