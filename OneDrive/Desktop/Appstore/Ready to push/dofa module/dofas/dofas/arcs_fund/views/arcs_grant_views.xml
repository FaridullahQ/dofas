<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_arcs_grant_form_fund" model="ir.ui.view">
        <field name="name">arcs.grant.form.fund</field>
        <field name="model">arcs.grant</field>
        <field name="inherit_id" ref="arcs_grant.view_arcs_grant_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='financial']//field[@name='analytic_account_id']" position="after">
                <field name="enforce_cash_availability"/>
                <field name="received_total"/>
            </xpath>
        </field>
    </record>
</odoo>
