<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_arcs_fund_receipt" model="ir.sequence">
        <field name="name">ARCS Fund Receipt</field>
        <field name="code">arcs.fund.receipt</field>
        <field name="prefix">FR-%(year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_arcs_donor_funding_request" model="ir.sequence">
        <field name="name">ARCS Donor Funding Request</field>
        <field name="code">arcs.donor.funding.request</field>
        <field name="prefix">DFR-%(year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
