<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_arcs_grant_form_multi_donor" model="ir.ui.view">
        <field name="name">arcs.grant.form.multi.donor</field>
        <field name="model">arcs.grant</field>
        <field name="inherit_id" ref="arcs_grant.view_arcs_grant_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="multi_donor_project_id" invisible="1"/>
                <button name="action_view_multi_donor_project" type="object"
                        class="oe_stat_button" icon="fa-handshake-o"
                        invisible="not multi_donor_project_id">
                    <span>Multi-Donor Project</span>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
