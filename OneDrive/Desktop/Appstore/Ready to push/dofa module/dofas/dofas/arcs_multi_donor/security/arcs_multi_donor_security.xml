<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="rule_arcs_multi_donor_project_donor_officer" model="ir.rule">
        <field name="name">arcs.multi.donor.project — Donor Officer sees only projects with a Managed Donor</field>
        <field name="model_id" ref="model_arcs_multi_donor_project"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_donor_officer'))]"/>
        <field name="domain_force">[('member_ids.donor_id', 'in', user.arcs_donor_ids.ids)]</field>
    </record>
    <record id="rule_arcs_multi_donor_project_admin_bypass" model="ir.rule">
        <field name="name">arcs.multi.donor.project — System Admin unrestricted</field>
        <field name="model_id" ref="model_arcs_multi_donor_project"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_system_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_arcs_multi_donor_shared_cost_donor_officer" model="ir.rule">
        <field name="name">arcs.multi.donor.shared.cost — Donor Officer sees only Managed Donors' shares</field>
        <field name="model_id" ref="model_arcs_multi_donor_shared_cost"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_donor_officer'))]"/>
        <field name="domain_force">[('project_id.member_ids.donor_id', 'in', user.arcs_donor_ids.ids)]</field>
    </record>
    <record id="rule_arcs_multi_donor_shared_cost_admin_bypass" model="ir.rule">
        <field name="name">arcs.multi.donor.shared.cost — System Admin unrestricted</field>
        <field name="model_id" ref="model_arcs_multi_donor_shared_cost"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_system_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
