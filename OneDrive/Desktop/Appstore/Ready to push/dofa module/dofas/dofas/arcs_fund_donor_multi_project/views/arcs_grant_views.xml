<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_arcs_grant_form_dmp" model="ir.ui.view">
        <field name="name">arcs.grant.form.dmp</field>
        <field name="model">arcs.grant</field>
        <field name="inherit_id" ref="arcs_grant.view_arcs_grant_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="funding_model" invisible="1"/>
                <button name="action_view_dmp_projects" type="object"
                        class="oe_stat_button" icon="fa-folder-open"
                        invisible="funding_model != 'donor_multi_project'">
                    <field name="dmp_project_count" widget="statinfo" string="Projects"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='financial']" position="inside">
                <group string="One Donor, Multiple Projects" invisible="funding_model != 'donor_multi_project'">
                    <field name="dmp_planned_total"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
