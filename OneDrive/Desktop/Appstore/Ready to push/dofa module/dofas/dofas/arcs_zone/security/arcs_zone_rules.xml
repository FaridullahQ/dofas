<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_arcs_zone_company" model="ir.rule">
        <field name="name">arcs.zone multi-company</field>
        <field name="model_id" ref="model_arcs_zone"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <!-- The old "arcs.department multi-company" rule was removed along with
         the arcs.department model it targeted (see migrations/17.0.1.4.0).
         hr.department is a shared core HR model - deliberately no global
         ir.rule is added here scoping it by company, since that would also
         affect every other app's use of hr.department, not just ARCS. -->
</odoo>
