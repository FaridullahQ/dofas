<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_arcs_lifecycle_close_wizard_form" model="ir.ui.view">
        <field name="name">arcs.lifecycle.close.wizard.form</field>
        <field name="model">arcs.lifecycle.close.wizard</field>
        <field name="arch" type="xml">
            <form string="Cannot close yet">
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    <i class="fa fa-exclamation-triangle me-2" title="Cannot close"/>
                    <strong><field name="record_name" readonly="1" class="oe_inline"/></strong>
                    can't be closed yet — <field name="blocker_count" readonly="1" class="oe_inline"/>
                    <field name="child_label" readonly="1" class="oe_inline"/> are still open:
                </div>
                <field name="blockers" readonly="1" nolabel="1"/>
                <p class="text-muted ms-1">
                    Close those first, or force-close everything now (this will also close the
                    open items listed above).
                </p>
                <footer>
                    <button name="action_force_close" string="Force close everything" type="object"
                            class="btn-danger"
                            confirm="This will close every open item listed above and then close this record. Continue?"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>