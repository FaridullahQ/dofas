<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="arcs_reimbursement_claim_company_rule" model="ir.rule">
        <field name="name">Reimbursement Claim: multi-company</field>
        <field name="model_id" ref="model_arcs_reimbursement_claim"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_arcs_reimbursement_claim_donor_officer_scope" model="ir.rule">
        <field name="name">arcs.reimbursement.claim — Donor Officer sees only Managed Donors</field>
        <field name="model_id" ref="model_arcs_reimbursement_claim"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_donor_officer'))]"/>
        <field name="domain_force">[('donor_id', 'in', user.arcs_donor_ids.ids)]</field>
    </record>
    <record id="rule_arcs_reimbursement_claim_admin_bypass" model="ir.rule">
        <field name="name">arcs.reimbursement.claim — System Admin unrestricted</field>
        <field name="model_id" ref="model_arcs_reimbursement_claim"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_system_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
