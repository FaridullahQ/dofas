<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="module_category_arcs" model="ir.module.category">
        <field name="name">ARCS Donor Management</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_donor_officer" model="res.groups">
        <field name="name">Donor Officer</field>
        <field name="category_id" ref="module_category_arcs"/>
    </record>
    <record id="group_program_officer" model="res.groups">
        <field name="name">Program Officer</field>
        <field name="category_id" ref="module_category_arcs"/>
    </record>
    <record id="group_dept_manager" model="res.groups">
        <field name="name">Department Manager</field>
        <field name="category_id" ref="module_category_arcs"/>
    </record>
    <record id="group_finance_officer" model="res.groups">
        <field name="name">Finance Officer</field>
        <field name="category_id" ref="module_category_arcs"/>
    </record>
    <record id="group_finance_manager" model="res.groups">
        <field name="name">Finance Manager</field>
        <field name="category_id" ref="module_category_arcs"/>
        <field name="implied_ids" eval="[(4, ref('group_finance_officer'))]"/>
    </record>
    <record id="group_compliance_officer" model="res.groups">
        <field name="name">Compliance Officer</field>
        <field name="category_id" ref="module_category_arcs"/>
    </record>
    <record id="group_procurement_officer" model="res.groups">
        <field name="name">Procurement Officer</field>
        <field name="category_id" ref="module_category_arcs"/>
    </record>
    <record id="group_project_manager" model="res.groups">
        <field name="name">Project Manager</field>
        <field name="category_id" ref="module_category_arcs"/>
    </record>
    <record id="group_executive_director" model="res.groups">
        <field name="name">Executive Director</field>
        <field name="category_id" ref="module_category_arcs"/>
    </record>
    <record id="group_system_admin" model="res.groups">
        <field name="name">System Administrator</field>
        <field name="category_id" ref="module_category_arcs"/>
        <field name="implied_ids" eval="[(4, ref('group_finance_manager')), (4, ref('group_executive_director')), (4, ref('group_compliance_officer')), (4, ref('group_procurement_officer')), (4, ref('group_program_officer')), (4, ref('group_project_manager')), (4, ref('group_dept_manager')), (4, ref('group_donor_officer'))]"/>
    </record>
</odoo>
