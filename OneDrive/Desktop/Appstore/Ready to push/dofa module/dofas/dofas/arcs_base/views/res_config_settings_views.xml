<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_arcs_config_settings" model="ir.ui.view">
        <field name="name">res.config.settings.arcs</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="ARCS Donor Mgmt" name="arcs_donor_management">
                    <block title="Analytic Integration" name="arcs_analytic">
                        <setting string="Default Grant Analytic Plan">
                            <field name="arcs_default_analytic_plan_id"/>
                        </setting>
                    </block>
                    <block title="Budget Controls" name="arcs_budget">
                        <setting string="Warning Threshold"><field name="arcs_budget_warn_threshold"/> %</setting>
                        <setting string="Alert Threshold"><field name="arcs_budget_alert_threshold"/> %</setting>
                    </block>
                    <block title="Multi-currency" name="arcs_currency">
                        <setting string="Currency Rate Policy"><field name="arcs_currency_rate_policy"/></setting>
                    </block>
                    <block title="Expense Accounting" name="arcs_expense">
                        <setting string="Expense Journal"><field name="arcs_expense_journal_id"/></setting>
                        <setting string="Expense Clearing Account"><field name="arcs_expense_clearing_account_id"/></setting>
                    </block>
                    <block title="Demo Data" name="arcs_demo">
                        <setting string="Demo Data"
                                 help="Generates ~30 interconnected demo records - donors, grants, budgets, the full Acquisition Four-Form flow, expenses, fund receipts, advances, and assets - so you can see every feature working end to end. Turning this off removes everything it created.">
                            <field name="arcs_demo_data_enabled" widget="boolean_toggle"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    <record id="action_arcs_config_settings" model="ir.actions.act_window">
        <field name="name">ARCS Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'arcs_donor_management'}</field>
    </record>
</odoo>
