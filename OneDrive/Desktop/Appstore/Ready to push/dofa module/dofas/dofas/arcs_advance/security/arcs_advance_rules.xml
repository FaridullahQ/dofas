<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         ADVANCE — multi-company (global, applies to all users)
    ═══════════════════════════════════════════════════════════════ -->
    <record id="rule_arcs_advance_company" model="ir.rule">
        <field name="name">arcs.advance — multi-company</field>
        <field name="model_id" ref="model_arcs_advance"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
        <field name="global" eval="True"/>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         LIQUIDATION — multi-company (global)
    ═══════════════════════════════════════════════════════════════ -->
    <record id="rule_arcs_liq_company" model="ir.rule">
        <field name="name">arcs.advance.liquidation — multi-company</field>
        <field name="model_id" ref="model_arcs_advance_liquidation"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
        <field name="global" eval="True"/>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         LIQUIDATION — holder scoping for non-manager users

         Finance Officers and Project Managers can READ all liquidations
         (needed for reporting and approval workflows), but can only
         CREATE / WRITE / DELETE their own (i.e. where they are the holder).

         Finance Managers and System Admins are NOT in the groups below,
         so these rules do not apply to them — they have full access.

         Rule logic:
           holder_user_id = current user        → their own liquidations
           OR holder_user_id = False            → advance has no specific holder (zone advances)
    ═══════════════════════════════════════════════════════════════ -->

    <!-- Finance Officers: read all, write/create/delete only own -->
    <record id="rule_arcs_liq_finoff_read" model="ir.rule">
        <field name="name">arcs.advance.liquidation — finance officer read all</field>
        <field name="model_id" ref="model_arcs_advance_liquidation"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_finance_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_arcs_liq_finoff_write" model="ir.rule">
        <field name="name">arcs.advance.liquidation — finance officer write own</field>
        <field name="model_id" ref="model_arcs_advance_liquidation"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_finance_officer'))]"/>
        <field name="domain_force">
            ['|', ('holder_user_id', '=', user.id), ('holder_user_id', '=', False)]
        </field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Project Managers: read all, write/create/delete only own -->
    <record id="rule_arcs_liq_proj_read" model="ir.rule">
        <field name="name">arcs.advance.liquidation — project manager read all</field>
        <field name="model_id" ref="model_arcs_advance_liquidation"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_project_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_arcs_liq_proj_write" model="ir.rule">
        <field name="name">arcs.advance.liquidation — project manager write own</field>
        <field name="model_id" ref="model_arcs_advance_liquidation"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_project_manager'))]"/>
        <field name="domain_force">
            ['|', ('holder_user_id', '=', user.id), ('holder_user_id', '=', False)]
        </field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Plain users (base.group_user): read only own liquidations -->
    <record id="rule_arcs_liq_user_own" model="ir.rule">
        <field name="name">arcs.advance.liquidation — plain user own records only</field>
        <field name="model_id" ref="model_arcs_advance_liquidation"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">
            ['|', ('holder_user_id', '=', user.id), ('holder_user_id', '=', False)]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         ADVANCE — holder scoping for non-manager users
         (employees can read their own issued advances to select them
         in the liquidation form's advance_id dropdown)
    ═══════════════════════════════════════════════════════════════ -->

    <record id="rule_arcs_advance_finoff_read" model="ir.rule">
        <field name="name">arcs.advance — finance officer read all</field>
        <field name="model_id" ref="model_arcs_advance"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_finance_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_arcs_advance_proj_read" model="ir.rule">
        <field name="name">arcs.advance — project manager read all</field>
        <field name="model_id" ref="model_arcs_advance"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_project_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_arcs_advance_user_own" model="ir.rule">
        <field name="name">arcs.advance — plain user own advances only</field>
        <field name="model_id" ref="model_arcs_advance"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">
            ['|',
                ('holder_user_id', '=', user.id),
                ('zone_id.manager_id', '=', user.id)
            ]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         DONOR OFFICER — scoped to Managed Donors, via grant_id.donor_id.
         System Admin implicitly inherits group_donor_officer, hence the
         explicit unrestricted bypass rules below.
    ═══════════════════════════════════════════════════════════════ -->
    <record id="rule_arcs_advance_donor_officer_scope" model="ir.rule">
        <field name="name">arcs.advance — Donor Officer sees only Managed Donors</field>
        <field name="model_id" ref="model_arcs_advance"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_donor_officer'))]"/>
        <field name="domain_force">[('grant_id.donor_id', 'in', user.arcs_donor_ids.ids)]</field>
    </record>
    <record id="rule_arcs_advance_donor_officer_admin_bypass" model="ir.rule">
        <field name="name">arcs.advance — System Admin unrestricted</field>
        <field name="model_id" ref="model_arcs_advance"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_system_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_arcs_liq_donor_officer_scope" model="ir.rule">
        <field name="name">arcs.advance.liquidation — Donor Officer sees only Managed Donors</field>
        <field name="model_id" ref="model_arcs_advance_liquidation"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_donor_officer'))]"/>
        <field name="domain_force">[('advance_id.grant_id.donor_id', 'in', user.arcs_donor_ids.ids)]</field>
    </record>
    <record id="rule_arcs_liq_donor_officer_admin_bypass" model="ir.rule">
        <field name="name">arcs.advance.liquidation — System Admin unrestricted</field>
        <field name="model_id" ref="model_arcs_advance_liquidation"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_system_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
