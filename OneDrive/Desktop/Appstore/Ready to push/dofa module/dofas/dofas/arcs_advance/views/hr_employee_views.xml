<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_form_inherit_arcs_advance" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.arcs.advance</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <field name="arcs_advance_count" invisible="1"/>
                <button name="action_view_arcs_advances" type="object"
                        class="oe_stat_button" icon="fa-money"
                        invisible="arcs_advance_count == 0">
                    <field name="arcs_advance_count" widget="statinfo" string="Advances"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
