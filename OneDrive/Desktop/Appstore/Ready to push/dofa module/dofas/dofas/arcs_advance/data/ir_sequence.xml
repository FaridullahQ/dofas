<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_arcs_advance" model="ir.sequence">
            <field name="name">ARCS Advance</field>
            <field name="code">arcs.advance</field>
            <field name="prefix">ADV/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_arcs_advance_liquidation" model="ir.sequence">
            <field name="name">ARCS Advance Liquidation</field>
            <field name="code">arcs.advance.liquidation</field>
            <field name="prefix">LIQ/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
