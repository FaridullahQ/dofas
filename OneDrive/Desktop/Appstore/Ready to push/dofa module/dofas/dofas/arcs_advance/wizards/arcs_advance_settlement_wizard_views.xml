<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_arcs_advance_settlement_wizard_form" model="ir.ui.view">
        <field name="name">arcs.advance.settlement.wizard.form</field>
        <field name="model">arcs.advance.settlement.wizard</field>
        <field name="arch" type="xml">
            <form string="Settle Advance">
                <field name="advance_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="direction" invisible="1"/>
                <div class="alert alert-info" role="alert" invisible="direction != 'return'">
                    <strong><field name="employee_id" readonly="1" nolabel="1" class="oe_inline"/></strong>
                    still holds unspent cash and is paying back the unused balance.
                </div>
                <div class="alert alert-warning" role="alert" invisible="direction != 'reimburse'">
                    <strong><field name="employee_id" readonly="1" nolabel="1" class="oe_inline"/></strong>
                    spent more than the advance and is being reimbursed the difference.
                </div>
                <group>
                    <group string="Advance">
                        <field name="amount_advanced" readonly="1"/>
                        <field name="reported_amount" readonly="1"/>
                        <field name="outstanding_amount" readonly="1"/>
                    </group>
                    <group string="Settlement">
                        <field name="settlement_amount"/>
                        <field name="journal_id"/>
                        <field name="reference" placeholder="e.g. deposit slip / payment voucher no."/>
                    </group>
                </group>
                <group>
                    <field name="attachment_ids" widget="many2many_binary"
                           string="Attachments (required)"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm Settlement" type="object"
                            class="oe_highlight"/>
                    <button name="action_discard" string="Discard" type="object"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
