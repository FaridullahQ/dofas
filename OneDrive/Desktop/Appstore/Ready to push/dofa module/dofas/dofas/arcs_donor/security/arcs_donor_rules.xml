<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ═══════════════════════════════════════════════════════════
         DONOR — Donor Officers are scoped to their Managed Donors.
         System Administrators implicitly inherit group_donor_officer
         (see arcs_base group implied_ids), so they get an explicit
         unrestricted bypass rule below - without it they would also
         be scoped down to Managed Donors.
    ═══════════════════════════════════════════════════════════════ -->
    <record id="rule_arcs_donor_officer_scope" model="ir.rule">
        <field name="name">arcs.donor — Donor Officer sees only Managed Donors</field>
        <field name="model_id" ref="model_arcs_donor"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_donor_officer'))]"/>
        <field name="domain_force">[('id', 'in', user.arcs_donor_ids.ids)]</field>
    </record>

    <record id="rule_arcs_donor_admin_bypass" model="ir.rule">
        <field name="name">arcs.donor — System Admin unrestricted</field>
        <field name="model_id" ref="model_arcs_donor"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_system_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
