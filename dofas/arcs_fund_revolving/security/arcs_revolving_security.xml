<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="arcs_revolving_cycle_company_rule" model="ir.rule">
        <field name="name">Revolving Fund Cycle: multi-company</field>
        <field name="model_id" ref="model_arcs_revolving_cycle"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Donor Officer: scoped to Managed Donors, mirroring arcs_grant's own
         rule pair. System Admin implicitly inherits group_donor_officer,
         hence the explicit bypass below. -->
    <record id="rule_arcs_revolving_cycle_donor_officer_scope" model="ir.rule">
        <field name="name">arcs.revolving.cycle — Donor Officer sees only Managed Donors</field>
        <field name="model_id" ref="model_arcs_revolving_cycle"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_donor_officer'))]"/>
        <field name="domain_force">[('donor_id', 'in', user.arcs_donor_ids.ids)]</field>
    </record>
    <record id="rule_arcs_revolving_cycle_donor_officer_admin_bypass" model="ir.rule">
        <field name="name">arcs.revolving.cycle — System Admin unrestricted</field>
        <field name="model_id" ref="model_arcs_revolving_cycle"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_system_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
