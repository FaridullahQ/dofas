<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_arcs_donor_report_form_revolving" model="ir.ui.view">
        <field name="name">arcs.donor.report.form.revolving</field>
        <field name="model">arcs.donor.report</field>
        <field name="inherit_id" ref="arcs_report.view_arcs_donor_report_form"/>
        <field name="arch" type="xml">
            <field name="report_type" position="after">
                <field name="grant_funding_model" invisible="1"/>
                <field name="revolving_cycle_id"
                       invisible="grant_funding_model != 'revolving_fund'"/>
            </field>
        </field>
    </record>
</odoo>
