<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_fund_thanks_allocation" inherit_id="arcs_fund.report_fund_thanks">
        <xpath expr="//div[hasclass('row') and hasclass('mt-5')]" position="before">
            <div t-if="o.allocation_ids" style="margin:20px 0;">
                <div style="font-size:13px; font-weight:bold; color:#1F3A5F; margin-bottom:8px;">
                    Program Allocation
                </div>
                <table style="width:100%; border-collapse:collapse; font-size:12px;">
                    <tr>
                        <td style="border:1px solid #1F3A5F; background:#1F3A5F; color:#fff; padding:6px 8px; font-weight:bold;">
                            Program
                        </td>
                        <td style="border:1px solid #1F3A5F; background:#1F3A5F; color:#fff; padding:6px 8px; font-weight:bold;">
                            Project
                        </td>
                        <td style="border:1px solid #1F3A5F; background:#1F3A5F; color:#fff; padding:6px 8px; font-weight:bold; text-align:right;">
                            Amount
                        </td>
                    </tr>
                    <tr t-foreach="o.allocation_ids" t-as="line">
                        <td style="border:1px solid #1F3A5F; padding:6px 8px;">
                            <span t-field="line.program_id.name"/>
                        </td>
                        <td style="border:1px solid #1F3A5F; padding:6px 8px;">
                            <span t-field="line.project_id.name"/>
                        </td>
                        <td style="border:1px solid #1F3A5F; padding:6px 8px; text-align:right;">
                            <span t-field="line.amount"
                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </td>
                    </tr>
                </table>
            </div>
        </xpath>
    </template>
</odoo>
