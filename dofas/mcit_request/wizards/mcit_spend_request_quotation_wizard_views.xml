<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcit_spend_request_quotation_wizard_form" model="ir.ui.view">
        <field name="name">mcit.spend.request.quotation.wizard.form</field>
        <field name="model">mcit.spend.request.quotation.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Real Price">
                <field name="request_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="line_ids">
                    <tree editable="bottom" create="0" delete="0">
                        <field name="request_line_id" invisible="1"/>
                        <field name="name" readonly="1"/>
                        <field name="quantity" readonly="1"/>
                        <field name="unit_estimate" readonly="1"/>
                        <field name="quoted_unit_price"/>
                        <field name="quoted_amount" sum="Approved (Quoted)"/>
                        <field name="currency_id" invisible="1"/>
                    </tree>
                </field>
                <group>
                    <group>
                        <field name="estimated_amount"/>
                        <field name="total_amount"/>
                        <field name="vendor_id" required="1"/>
                    </group>
                    <group>
                        <field name="quotation_ref" required="1" placeholder="e.g. QTN-2026-0044"/>
                        <field name="attachment_ids" widget="many2many_binary" required="1"
                               string="Approved Quotations (required)"/>
                    </group>
                </group>
                <field name="note" placeholder="Notes for the finance manager (optional)"/>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="oe_highlight"/>
                    <button name="action_discard" string="Discard" type="object"
                            class="btn-secondary"/>
                    <button name="action_stay" string="Stay Here" type="object"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
