<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcit_spend_request_tree" model="ir.ui.view">
        <field name="name">mcit.spend.request.tree</field><field name="model">mcit.spend.request</field>
        <field name="arch" type="xml">
            <tree decoration-info="state=='committed'" decoration-success="state=='approved'" decoration-warning="state=='insufficient_funds'" decoration-muted="state in ('rejected','cancelled')">
                <field name="name"/><field name="date_request"/><field name="zone_id"/>
                <field name="department_id" optional="show"/><field name="budget_line_id"/>
                <field name="estimated_amount" sum="Estimated"/><field name="approved_amount" sum="Approved" optional="show"/><field name="currency_id" invisible="1"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_mcit_spend_request_form" model="ir.ui.view">
        <field name="name">mcit.spend.request.form</field><field name="model">mcit.spend.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_open_quotation_wizard" string="Confirm Real Price" type="object" invisible="state != 'submitted'"/>
                    <button name="action_commit" string="Commit &amp; Reserve" type="object" class="oe_highlight" invisible="state != 'submitted' or not approved_amount" groups="mcit_base.group_finance_manager"/>
                    <button name="action_choose_different_budget_line" string="Choose Different Budget Line" type="object" class="oe_highlight" invisible="state != 'insufficient_funds'"/>
                    <button name="action_request_budget_transfer" string="Request Internal Transfer" type="object" invisible="state != 'insufficient_funds'"/>
                    <button name="action_request_donor_funding" string="Request Donor Funding" type="object" invisible="state != 'insufficient_funds'"/>
                    <button name="action_reset_draft" string="Revise Request" type="object" invisible="state != 'insufficient_funds'"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'committed'" groups="mcit_base.group_executive_director"/>
                    <button name="action_create_expense" string="Create Expense" type="object" invisible="state != 'approved'"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state not in ('submitted','committed')"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('approved','rejected','cancelled')"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state not in ('rejected','cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,committed,approved"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="state != 'insufficient_funds'">
                        <field name="insufficient_funds_note" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="state != 'submitted' or approved_amount">
                        Click <strong>Confirm Real Price</strong> to record the vendor's quotation
                        before Commit &amp; Reserve becomes available.
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <field name="commitment_id" invisible="1"/>
                        <button name="action_view_expenses" type="object" class="oe_stat_button" icon="fa-money" invisible="expense_count == 0">
                            <field name="expense_count" widget="statinfo" string="Expenses"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Requesting unit">
                            <field name="zone_id"/>
                            <field name="department_id"/>
                            <field name="budget_holder_id"/>
                            <field name="requested_by"/>
                            <field name="date_request"/>
                        </group>
                        <group string="Budget">
                            <field name="budget_line_id"/>
                            <field name="grant_id"/>
                            <field name="program_id"/>
                            <field name="project_id"/>
                            <field name="activity_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="estimated_amount"/>
                            <field name="approved_amount"/>
                            <field name="quotation_ref"/>
                            <field name="vendor_id"/>
                            <field name="shortfall_amount" invisible="not shortfall_amount"/>
                            <field name="available_on_line"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items" name="items">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="unit_estimate"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="note" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Justification / remarks"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_mcit_spend_request_search" model="ir.ui.view">
        <field name="name">mcit.spend.request.search</field><field name="model">mcit.spend.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="zone_id"/><field name="department_id"/>
                <field name="budget_line_id"/><field name="grant_id"/><field name="program_id"/><field name="project_id"/>
                <filter name="draft" string="Drafted" domain="[('state','=','draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="insufficient_funds" string="Insufficient Funds" domain="[('state','=','insufficient_funds')]"/>
                <filter name="committed" string="Committed" domain="[('state','=','committed')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <group expand="0" string="Group By">
                    <filter name="g_zone" string="Zone" context="{'group_by':'zone_id'}"/>
                    <filter name="g_program" string="Program" context="{'group_by':'program_id'}"/>
                    <filter name="g_grant" string="Grant" context="{'group_by':'grant_id'}"/>
                    <filter name="g_state" string="Status" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mcit_spend_request" model="ir.actions.act_window">
        <field name="name">Acquisitions</field>
        <field name="res_model">mcit.spend.request</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
