<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_rag" model="ir.ui.view">
        <field name="name">res.config.settings.form.mcit.rag</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Ask DoFAS" string="Ask DoFAS" name="mcit_rag_assistant">
                    <block title="Assistant" name="mcit_rag_general">
                        <setting string="Enable Ask DoFAS Assistant"
                                 help="Master on/off switch for this company.">
                            <field name="mcit_rag_enabled"/>
                        </setting>
                        <setting string="Chunks Retrieved per Question"
                                 help="How many relevant record snippets are given to the model as context.">
                            <field name="mcit_rag_top_k"/>
                        </setting>
                    </block>
                    <block title="Generation (Ollama - self-hosted, free)" name="mcit_rag_ollama">
                        <setting string="Ollama Base URL">
                            <field name="mcit_rag_ollama_url"/>
                        </setting>
                        <setting string="Ollama Chat Model"
                                 help="Must already be pulled on the Ollama server, e.g. 'ollama pull llama3.1:8b'.">
                            <field name="mcit_rag_ollama_model"/>
                        </setting>
                    </block>
                    <block title="Embeddings (local, free)" name="mcit_rag_embeddings">
                        <setting string="Embedding Model"
                                 help="A sentence-transformers model id. Changing this after records are indexed requires a full reindex.">
                            <field name="mcit_rag_embedding_model"/>
                        </setting>
                        <setting string="Search Index"
                                 help="Rebuild the entire DoFAS search index from scratch.">
                            <button name="action_mcit_rag_reindex_all" type="object"
                                    string="Reindex All Now" class="btn-secondary"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_mcit_rag_settings" model="ir.actions.act_window">
        <field name="name">Ask DoFAS Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'mcit_rag_assistant'}</field>
    </record>
</odoo>
