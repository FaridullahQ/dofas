<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mcit_rag_assistant.Systray" owl="1">
        <div class="o_mcit_rag_systray">
            <button class="o_mcit_rag_systray_icon" title="Ask DoFAS" t-on-click="() => this.toggle()">
                <i class="fa fa-magic"/>
            </button>

            <t t-if="state.open">
                <div class="o_mcit_rag_backdrop" t-on-click="() => this.close()"/>
                <div class="o_mcit_rag_panel">
                    <div class="o_mcit_rag_panel_header">
                        <div>
                            <h3>Ask DoFAS</h3>
                            <span class="o_mcit_rag_subtitle">Grounded in your DoFAS data</span>
                        </div>
                        <span class="o_mcit_rag_close" t-on-click="() => this.close()">
                            <i class="fa fa-times"/>
                        </span>
                    </div>

                    <div class="o_mcit_rag_messages">
                        <t t-foreach="state.messages" t-as="msg" t-key="msg_index">
                            <div t-attf-class="o_mcit_rag_msg o_mcit_rag_msg_{{ msg.role }} {{ msg.isError ? 'o_mcit_rag_msg_error' : '' }}">
                                <div class="o_mcit_rag_bubble">
                                    <t t-esc="msg.text"/>
                                </div>
                                <div t-if="msg.sources and msg.sources.length" class="o_mcit_rag_sources">
                                    <span class="o_mcit_rag_sources_label">Sources:</span>
                                    <t t-foreach="msg.sources" t-as="src" t-key="src.model + src.res_id">
                                        <button class="o_mcit_rag_source_chip" t-on-click="() => this.openSource(src)">
                                            <t t-esc="src.name"/>
                                        </button>
                                    </t>
                                </div>
                            </div>
                        </t>
                        <div t-if="state.loading" class="o_mcit_rag_msg o_mcit_rag_msg_assistant">
                            <div class="o_mcit_rag_bubble o_mcit_rag_thinking">
                                <i class="fa fa-spinner fa-spin"/> Thinking...
                            </div>
                        </div>
                    </div>

                    <div class="o_mcit_rag_input_bar">
                        <textarea t-ref="input"
                                  t-model="state.question"
                                  t-on-keydown="onKeydown"
                                  placeholder="Ask a question..."
                                  rows="1"/>
                        <button class="o_mcit_rag_send" t-on-click="() => this.send()" t-att-disabled="state.loading">
                            <i class="fa fa-paper-plane"/>
                        </button>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
