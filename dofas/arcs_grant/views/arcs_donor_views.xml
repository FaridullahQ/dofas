<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_arcs_donor_form_grant" model="ir.ui.view">
        <field name="name">arcs.donor.form.grant</field>
        <field name="model">arcs.donor</field>
        <field name="inherit_id" ref="arcs_donor.view_arcs_donor_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reporting_frequency']" position="after">
                <field name="grant_count"/>
            </xpath>
        </field>
    </record>
</odoo>
