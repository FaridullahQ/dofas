<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcit_department_tree" model="ir.ui.view">
        <field name="name">mcit.department.tree</field><field name="model">mcit.department</field>
        <field name="arch" type="xml">
            <tree string="Departments" editable="bottom" default_order="code, name"
                  decoration-muted="not active">
                <field name="code" placeholder="e.g. HEALTH"/>
                <field name="name" placeholder="e.g. Health"/>
                <field name="zone_id"/>
                <field name="manager_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>
    <record id="view_mcit_department_form" model="ir.ui.view">
        <field name="name">mcit.department.form</field><field name="model">mcit.department</field>
        <field name="arch" type="xml">
            <form string="Department">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Health"/></h1>
                        <h3 class="text-muted mt-0"><field name="code" class="oe_inline" placeholder="e.g. HEALTH"/></h3>
                    </div>
                    <group>
                        <group string="Details">
                            <field name="zone_id" help="The province this department belongs to."/>
                            <field name="manager_id" help="Person responsible for this department."/>
                        </group>
                        <group string="Company" groups="base.group_multi_company">
                            <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_mcit_department_search" model="ir.ui.view">
        <field name="name">mcit.department.search</field><field name="model">mcit.department</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Department" filter_domain="['|',('name','ilike',self),('code','ilike',self)]"/>
                <field name="code"/><field name="zone_id"/><field name="manager_id"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter name="g_zone" string="Province" context="{'group_by':'zone_id'}"/>
                    <filter name="g_manager" string="Manager" context="{'group_by':'manager_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_mcit_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">mcit.department</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_mcit_department_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first department</p>
            <p>Departments are the functional units used to classify requests and expenses.</p>
        </field>
    </record>
</odoo>