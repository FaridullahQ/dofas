<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcit_zone_tree" model="ir.ui.view">
        <field name="name">mcit.zone.tree</field>
        <field name="model">mcit.zone</field>
        <field name="arch" type="xml">
            <tree string="Zones / Provinces" default_order="code, name"
                  decoration-muted="not active" decoration-bf="kind=='hq'">
                <field name="active" column_invisible="1"/>
                <field name="code"/>
                <field name="name"/>
                <field name="kind" widget="badge"
                       decoration-info="kind=='hq'" decoration-success="kind=='zone'"
                       decoration-warning="kind=='province'"/>
                <field name="parent_id" optional="show"/>
                <field name="manager_id" optional="show"/>
                <field name="budget_holder_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>
    <record id="view_mcit_zone_form" model="ir.ui.view">
        <field name="name">mcit.zone.form</field>
        <field name="model">mcit.zone</field>
        <field name="arch" type="xml">
            <form string="Zone / Province">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_children" type="object"
                                class="oe_stat_button" icon="fa-sitemap"
                                invisible="kind == 'province'">
                            <field name="child_count" widget="statinfo"
                                   string="Provinces" invisible="kind != 'zone'"/>
                            <field name="child_count" widget="statinfo"
                                   string="Zones" invisible="kind != 'hq'"/>
                        </button>
                        <button name="action_view_departments" type="object"
                                class="oe_stat_button" icon="fa-building"
                                invisible="kind != 'province'">
                            <field name="department_count" widget="statinfo" string="Departments"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Herat Zone"/>
                        </h1>
                        <h3 class="text-muted mt-0">
                            <field name="code" class="oe_inline" placeholder="e.g. HRT"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="kind"
                                   help="Headquarters, a regional Zone, or a Province that sits under a zone."/>
                            <field name="parent_id"
                                   help="The parent unit this zone/province reports to (e.g. a province reports to its zone)."/>
                        </group>
                        <group string="People">
                            <field name="manager_id" help="Person responsible for running this unit."/>
                            <field name="budget_holder_id"/>
                        </group>
                    </group>
                    <group groups="base.group_multi_company">
                        <field name="company_id"/>
                    </group>
                    <separator string="Notes"/>
                    <field name="note" nolabel="1" placeholder="Anything useful about this unit…"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_mcit_zone_search" model="ir.ui.view">
        <field name="name">mcit.zone.search</field>
        <field name="model">mcit.zone</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Zone" filter_domain="['|',('name','ilike',self),('code','ilike',self)]"/>
                <field name="code"/>
                <field name="manager_id"/>
                <field name="budget_holder_id"/>
                <field name="parent_id"/>
                <separator/>
                <filter name="hq" string="Headquarters" domain="[('kind','=','hq')]"/>
                <filter name="zones" string="Zones" domain="[('kind','=','zone')]"/>
                <filter name="provinces" string="Provinces" domain="[('kind','=','province')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter name="g_kind" string="Type" context="{'group_by':'kind'}"/>
                    <filter name="g_parent" string="Reports To" context="{'group_by':'parent_id'}"/>
                    <filter name="g_manager" string="Manager" context="{'group_by':'manager_id'}"/>
                </group>
                <searchpanel>
                    <field name="kind" string="Type" icon="fa-sitemap" enable_counters="1"/>
                    <field name="parent_id" string="Reports To" icon="fa-level-up" enable_counters="1" select="multi"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="action_mcit_zone" model="ir.actions.act_window">
        <field name="name">Zones / Provinces</field>
        <field name="res_model">mcit.zone</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_mcit_zone_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your headquarters, zones and provinces</p>
            <p>These are the field offices used to track requests, expenses and advances across the organisation.</p>
        </field>
    </record>
</odoo>