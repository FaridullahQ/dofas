<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_mcit_zone_company" model="ir.rule">
        <field name="name">mcit.zone multi-company</field>
        <field name="model_id" ref="model_mcit_zone"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_mcit_dept_company" model="ir.rule">
        <field name="name">mcit.department multi-company</field>
        <field name="model_id" ref="model_mcit_department"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
