<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcit_reason_wizard_form" model="ir.ui.view">
        <field name="name">mcit.reason.wizard.form</field>
        <field name="model">mcit.reason.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <field name="target_action" invisible="1"/>
                <div class="o_form_label mb-2">
                    <field name="title" readonly="1" nolabel="1" class="fw-bold"/>
                    — please provide a justification before continuing.
                </div>
                <field name="reason" nolabel="1" placeholder="Explain why..." autofocus="1"/>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="oe_highlight"/>
                    <button name="action_discard" string="Discard" type="object"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
