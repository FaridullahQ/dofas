<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_arcs_grant_form_earmarked" model="ir.ui.view">
        <field name="name">arcs.grant.form.earmarked</field>
        <field name="model">arcs.grant</field>
        <field name="inherit_id" ref="arcs_grant.view_arcs_grant_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="funding_model" invisible="1"/>
                <button name="action_view_earmarked_projects" type="object"
                        class="oe_stat_button" icon="fa-sitemap"
                        invisible="funding_model != 'earmarked'">
                    <field name="earmarked_project_count" widget="statinfo" string="Projects"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
