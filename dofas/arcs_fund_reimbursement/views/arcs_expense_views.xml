<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_arcs_expense_form_reimbursement" model="ir.ui.view">
        <field name="name">arcs.expense.form.reimbursement</field>
        <field name="model">arcs.expense</field>
        <field name="inherit_id" ref="arcs_expense.view_arcs_expense_form"/>
        <field name="arch" type="xml">
            <field name="budget_line_id" position="after">
                <field name="grant_funding_model" invisible="1"/>
                <field name="reimbursement_claim_id"
                       invisible="grant_funding_model != 'reimbursement'"
                       required="grant_funding_model == 'reimbursement'"/>
            </field>
        </field>
    </record>
    <record id="view_arcs_expense_tree_reimbursement" model="ir.ui.view">
        <field name="name">arcs.expense.tree.reimbursement</field>
        <field name="model">arcs.expense</field>
        <field name="inherit_id" ref="arcs_expense.view_arcs_expense_tree"/>
        <field name="arch" type="xml">
            <field name="budget_line_id" position="after">
                <field name="reimbursement_claim_id" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
