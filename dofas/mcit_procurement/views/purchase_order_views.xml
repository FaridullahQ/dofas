<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_mcit" model="ir.ui.view">
        <field name="name">purchase.order.form.mcit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="mcit_grant_id"/>
                <field name="mcit_budget_line_id"/>
                <field name="mcit_commitment_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
