        <field name="domain_force">[('grant_id.donor_id', 'in', user.arcs_donor_ids.ids)]</field>
    </record>
    <record id="rule_arcs_release_schedule_admin_bypass" model="ir.rule">
        <field name="name">Release Schedule — System Admin unrestricted</field>
        <field name="model_id" ref="model_arcs_grant_release_schedule_line"/>
        <field name="groups" eval="[(4, ref('arcs_base.group_system_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_arcs_compliance_verification_company" model="ir.rule">
