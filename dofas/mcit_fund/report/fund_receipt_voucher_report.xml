<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_fund_receipt_voucher" model="ir.actions.report">
        <field name="name">Fund Receipt Voucher</field>
        <field name="model">mcit.fund.receipt</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mcit_fund.report_fund_receipt_voucher</field>
        <field name="report_file">mcit_fund.report_fund_receipt_voucher</field>
        <field name="print_report_name">'Fund Receipt Voucher - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_mcit_fund_receipt"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_fund_receipt_voucher">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-call="mcit_base.report_voucher_document"/>
                </t>
            </t>
        </t>
    </template>
</odoo>
