<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Donor Officer: scoped to Managed Donors. System Admin implicitly
         inherits group_donor_officer, hence the explicit bypass below. -->
    <record id="rule_mcit_fund_receipt_donor_officer_scope" model="ir.rule">
        <field name="name">mcit.fund.receipt — Donor Officer sees only Managed Donors</field>
        <field name="model_id" ref="model_mcit_fund_receipt"/>
        <field name="groups" eval="[(4, ref('mcit_base.group_donor_officer'))]"/>
        <field name="domain_force">[('donor_id', 'in', user.mcit_donor_ids.ids)]</field>
    </record>
    <record id="rule_mcit_fund_receipt_donor_officer_admin_bypass" model="ir.rule">
        <field name="name">mcit.fund.receipt — System Admin unrestricted</field>
        <field name="model_id" ref="model_mcit_fund_receipt"/>
        <field name="groups" eval="[(4, ref('mcit_base.group_system_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
