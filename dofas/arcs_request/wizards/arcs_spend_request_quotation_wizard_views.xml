<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_arcs_spend_request_quotation_wizard_form" model="ir.ui.view">
        <field name="name">arcs.spend.request.quotation.wizard.form</field>
        <field name="model">arcs.spend.request.quotation.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Real Price">
                <field name="request_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <div class="o_form_label text-muted mb-2">
                    Record the vendor's real quoted price for
                    <field name="request_id" readonly="1" nolabel="1" class="oe_inline fw-bold"/>,
                    line by line. This confirmed amount - not the original estimate - is what
                    will be reserved on the budget and posted to the journal.
                </div>
                <separator string="Quoted Items"/>
                <field name="line_ids">
                    <tree editable="bottom" create="0" delete="0">
                        <field name="request_line_id" column_invisible="1"/>
                        <field name="name" readonly="1" string="Item"/>
                        <field name="quantity" readonly="1"/>
                        <field name="unit_estimate" readonly="1" string="Estimated Unit Price"/>
                        <field name="quoted_unit_price" string="Quoted Unit Price"/>
                        <field name="quoted_amount" sum="Approved (Quoted)"/>
                        <field name="currency_id" column_invisible="1"/>
                    </tree>
                </field>
                <div class="row mt-3">
                    <div class="col-7">
                        <div class="p-3 bg-light rounded">
                            <h6 class="text-muted">Vendor &amp; Documentation</h6>
                            <group>
                                <field name="vendor_id" required="1"
                                       placeholder="Select the quoting vendor..."/>
                                <field name="quotation_ref" required="1"
                                       placeholder="e.g. QTN-2026-0044"/>
                                <field name="attachment_ids" widget="many2many_binary" required="1"
                                       string="Approved Quotations"/>
                            </group>
                            <field name="note" placeholder="Notes for the finance manager (optional)..."
                                   nolabel="1"/>
                        </div>
                    </div>
                    <div class="col-5">
                        <div class="p-3 bg-light rounded">
                            <h6 class="text-muted">Price Summary</h6>
                            <group>
                                <field name="estimated_amount"/>
                                <field name="total_amount" class="fw-bold"/>
                                <field name="variance_amount"/>
                            </group>
                        </div>
                    </div>
                </div>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="oe_highlight"/>
                    <button name="action_discard" string="Discard" type="object"
                            class="btn-secondary"/>
                    <button name="action_stay" string="Stay Here" type="object"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
