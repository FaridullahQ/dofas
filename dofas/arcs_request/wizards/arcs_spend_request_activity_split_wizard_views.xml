<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_arcs_spend_request_activity_split_wizard_form" model="ir.ui.view">
        <field name="name">arcs.spend.request.activity.split.wizard.form</field>
        <field name="model">arcs.spend.request.activity.split.wizard</field>
        <field name="arch" type="xml">
            <form string="Split Reserve Across Activities">
                <field name="request_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <div class="o_form_label text-muted mb-2">
                    The primary activity doesn't have enough Planned Cost to cover the
                    approved amount on its own. Reserve part of it here on the primary
                    activity, and cover the rest from one or more other activities -
                    each portion is reserved and tracked separately. The budget line
                    itself already has room for the full amount; only the activity
                    ceiling is being split.
                </div>
                <div class="row mt-2">
                    <div class="col-6">
                        <div class="p-3 bg-light rounded">
                            <h6 class="text-muted">Primary Activity</h6>
                            <group>
                                <field name="primary_activity_id" readonly="1"/>
                                <field name="primary_available" readonly="1"/>
                                <field name="primary_amount"/>
                            </group>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-light rounded">
                            <h6 class="text-muted">Allocation Summary</h6>
                            <group>
                                <field name="approved_amount"/>
                                <field name="total_allocated" class="fw-bold"/>
                                <field name="remaining_to_allocate"
                                       class="fw-bold text-danger"
                                       invisible="not remaining_to_allocate"/>
                            </group>
                        </div>
                    </div>
                </div>
                <separator string="Other Activities"/>
                <field name="line_ids">
                    <tree editable="bottom">
                        <field name="activity_id"/>
                        <field name="available_amount" readonly="1"/>
                        <field name="amount" sum="Allocated"/>
                        <field name="currency_id" column_invisible="1"/>
                    </tree>
                </field>
                <separator string="Justification"/>
                <group>
                    <field name="reference" placeholder="Approval memo, justification, etc."/>
                </group>
                <group>
                    <field name="attachment_ids" widget="many2many_binary"
                           string="Attachments (required)"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm Split &amp; Commit" type="object"
                            class="oe_highlight"/>
                    <button name="action_discard" string="Discard" type="object"
                            class="btn-secondary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
