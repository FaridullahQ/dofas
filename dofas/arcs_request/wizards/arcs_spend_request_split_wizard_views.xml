<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_arcs_spend_request_split_wizard_form" model="ir.ui.view">
        <field name="name">arcs.spend.request.split.wizard.form</field>
        <field name="model">arcs.spend.request.split.wizard</field>
        <field name="arch" type="xml">
            <form string="Split Reserve Across Budget Lines">
                <field name="request_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <div class="o_form_label text-muted mb-2">
                    The primary budget line doesn't have enough available to cover the
                    approved amount on its own. Reserve part of it here on the primary
                    line, and cover the rest from one or more other budget lines -
                    each portion is reserved and tracked separately.
                </div>
                <div class="row mt-2">
                    <div class="col-6">
                        <div class="p-3 bg-light rounded">
                            <h6 class="text-muted">Primary Budget Line</h6>
                            <group>
                                <field name="primary_budget_line_id" readonly="1"/>
                                <field name="primary_available" readonly="1"/>
                                <field name="primary_amount"/>
                            </group>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-light rounded">
                            <h6 class="text-muted">Allocation Summary</h6>
                            <group>
                                <field name="approved_amount"/>
                                <field name="total_allocated" class="fw-bold"/>
                                <field name="remaining_to_allocate"
                                       class="fw-bold text-danger"
                                       invisible="not remaining_to_allocate"/>
                            </group>
                        </div>
                    </div>
                </div>
                <separator string="Other Budget Lines"/>
                <field name="line_ids">
                    <tree editable="bottom">
                        <field name="budget_line_id"/>
                        <field name="available_amount" readonly="1"/>
                        <field name="amount" sum="Allocated"/>
                        <field name="currency_id" column_invisible="1"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_confirm" string="Confirm Split &amp; Commit" type="object"
                            class="oe_highlight"/>
                    <button name="action_discard" string="Discard" type="object"
                            class="btn-secondary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
