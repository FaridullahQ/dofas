<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_arcs_spend_request_activity_reassign_wizard_form" model="ir.ui.view">
        <field name="name">arcs.spend.request.activity.reassign.wizard.form</field>
        <field name="model">arcs.spend.request.activity.reassign.wizard</field>
        <field name="arch" type="xml">
            <form string="Choose a Different Activity">
                <field name="request_id" invisible="1"/>
                <group>
                    <field name="current_activity_id"/>
                    <field name="new_activity_id"/>
                    <field name="note"/>
                    <field name="reference" placeholder="Approval memo, justification, etc."/>
                </group>
                <group>
                    <field name="attachment_ids" widget="many2many_binary"
                           string="Attachments (required)"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Reassign &amp; Resubmit" type="object"
                            class="oe_highlight"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
