<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_acquisition_voucher" model="ir.actions.report">
        <field name="name">Acquisition Commitment Voucher</field>
        <field name="model">arcs.spend.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">arcs_request.report_acquisition_voucher</field>
        <field name="report_file">arcs_request.report_acquisition_voucher</field>
        <field name="print_report_name">'Acquisition Voucher - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_arcs_spend_request"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_acquisition_voucher">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-call="arcs_base.report_voucher_document"/>
                </t>
            </t>
        </t>
    </template>
</odoo>
