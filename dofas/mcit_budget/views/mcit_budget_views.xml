<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcit_budget_form" model="ir.ui.view">
        <field name="name">mcit.budget.form</field>
        <field name="model">mcit.budget</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state!='draft'"/>
                    <button name="action_create_revision" string="Create Revision" type="object" invisible="state!='approved'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="grant_id" readonly="state!='draft'"/>
                            <field name="version"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="planned_total"/>
                            <field name="available_total"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state!='draft'">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name" placeholder="e.g. Salaries"/>
                            <field name="category"/>
                            <field name="account_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="planned_amount" sum="Planned"/>
                            <field name="committed_amount" sum="Committed"/>
                            <field name="actual_amount" sum="Actual"/>
                            <field name="available_amount" sum="Available"/>
                            <field name="utilization" optional="show"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_mcit_budget_tree" model="ir.ui.view">
        <field name="name">mcit.budget.tree</field>
        <field name="model">mcit.budget</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/><field name="grant_id"/><field name="version"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="planned_total"/><field name="available_total"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>
    <record id="action_mcit_budget" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">mcit.budget</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_mcit_commitment_tree" model="ir.ui.view">
        <field name="name">mcit.commitment.tree</field>
        <field name="model">mcit.commitment</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false">
                <field name="create_date"/><field name="grant_id"/><field name="budget_line_id"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount" sum="Committed"/><field name="source_ref" optional="show"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>
    <record id="action_mcit_commitment" model="ir.actions.act_window">
        <field name="name">Commitments</field>
        <field name="res_model">mcit.commitment</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
