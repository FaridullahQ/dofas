<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcit_budget_transfer_tree" model="ir.ui.view">
        <field name="name">mcit.budget.transfer.tree</field>
        <field name="model">mcit.budget.transfer</field>
        <field name="arch" type="xml">
            <tree decoration-success="state=='approved'" decoration-danger="state=='rejected'">
                <field name="name"/>
                <field name="from_line_id"/>
                <field name="to_line_id"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" invisible="1"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_mcit_budget_transfer_form" model="ir.ui.view">
        <field name="name">mcit.budget.transfer.form</field>
        <field name="model">mcit.budget.transfer</field>
        <field name="arch" type="xml">
            <form string="Internal Budget Transfer">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="oe_highlight" invisible="state != 'submitted'"
                            groups="mcit_base.group_finance_manager"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'submitted'"
                            groups="mcit_base.group_finance_manager"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'submitted')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="from_line_id" required="1"/>
                            <field name="to_line_id"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason" nolabel="1" placeholder="Why is this transfer needed?"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_mcit_budget_transfer" model="ir.actions.act_window">
        <field name="name">Internal Budget Transfers</field>
        <field name="res_model">mcit.budget.transfer</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
