<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mcit_budget_company_rule" model="ir.rule">
        <field name="name">Budget: multi-company</field>
        <field name="model_id" ref="model_mcit_budget"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id','in',company_ids)]</field>
    </record>
    <record id="mcit_budget_transfer_company_rule" model="ir.rule">
        <field name="name">Budget Transfer: multi-company</field>
        <field name="model_id" ref="model_mcit_budget_transfer"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id','in',company_ids)]</field>
    </record>
</odoo>
