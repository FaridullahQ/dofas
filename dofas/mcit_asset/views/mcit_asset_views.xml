<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mcit_asset_tree" model="ir.ui.view">
        <field name="name">mcit.asset.tree</field>
        <field name="model">mcit.asset</field>
        <field name="arch" type="xml">
            <tree string="Assets" decoration-success="state=='in_use'"
                  decoration-warning="state in ('in_store','transferred')"
                  decoration-danger="state in ('disposed','lost')">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="grant_id"/>
                <field name="custodian_id"/>
                <field name="current_location_id" optional="show"/>
                <field name="acquisition_date"/>
                <field name="acquisition_cost" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state=='in_use'"
                       decoration-warning="state in ('in_store','transferred')"
                       decoration-danger="state in ('disposed','lost')"/>
                <field name="company_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_mcit_asset_form" model="ir.ui.view">
        <field name="name">mcit.asset.form</field>
        <field name="model">mcit.asset</field>
        <field name="arch" type="xml">
            <form string="Asset">
                <header>
                    <button name="action_print_voucher" string="Print Voucher" type="object"/>
                    <button name="action_print_disposal_voucher" string="Print Disposal Voucher"
                            type="object" invisible="state != 'disposed'"/>
                    <button name="action_set_in_store" string="Move to Store"
                            type="object" invisible="state != 'in_use'"
                            help="Internal transfer this unit into the Store location."
                            confirm="This will internally transfer the asset into the Store location. Do you want to continue?"/>
                    <button name="action_set_in_use" string="Return to Use"
                            type="object"
                            invisible="state not in ('in_store','transferred')"
                            help="Internal transfer this unit back to the Custody location."
                            confirm="This will internally transfer the asset back to the Custody location. Do you want to continue?"/>
                    <button name="action_transfer" string="Transfer" type="object"
                            invisible="state in ('disposed','lost')"
                            help="Hand the asset to a custodian and lock it to them."
                            confirm="This will hand the asset to the selected custodian and lock it to them until transferred again. Do you want to continue?"/>
                    <button name="action_dispose" string="Dispose" type="object"
                            class="oe_highlight"
                            groups="mcit_asset.group_asset_manager"
                            invisible="state in ('disposed','lost')"
                            confirm="Disposing this asset will remove it from active use and post a disposal entry. This action cannot be undone. Do you want to continue?"/>
                    <button name="action_mark_lost" string="Mark Lost" type="object"
                            groups="mcit_asset.group_asset_manager"
                            invisible="state in ('disposed','lost')"
                            confirm="Marking this asset as lost is a permanent record of loss and cannot be undone. Do you want to continue?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="in_use,in_store,transferred,disposed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Disposed" bg_color="text-bg-danger"
                            invisible="state != 'disposed'"/>
                    <widget name="web_ribbon" title="Lost" bg_color="text-bg-danger"
                            invisible="state != 'lost'"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_stock_moves" type="object"
                                class="oe_stat_button" icon="fa-exchange"
                                invisible="not lot_id">
                            <field name="move_line_count" widget="statinfo"
                                   string="Moves"/>
                        </button>
                        <button name="action_view_disposal_move" type="object"
                                class="oe_stat_button" icon="fa-book"
                                invisible="not disposal_move_id">
                            <span class="o_stat_text">Disposal<br/>Entry
                            </span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Toyota Hilux 4x4"/>
                        </h1>
                        <label for="code" class="oe_inline"/>
                        <h2>
                            <field name="code" class="oe_inline"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Funding">
                            <field name="grant_id"/>
                            <field name="donor_id"/>
                            <field name="project_id"/>
                            <field name="expense_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group string="Asset Details">
                            <field name="category"/>
                            <field name="acquisition_date"/>
                            <field name="acquisition_cost"/>
                            <field name="cost_expense_mismatch" invisible="1"/>
                            <field name="quantity"/>
                            <field name="serial_number"
                                   placeholder="VIN / chassis / serial..."/>
                            <field name="custodian_id"
                                   placeholder="Responsible person or office..."/>
                            <field name="location_note"
                                   placeholder="e.g. ARCS Herat Branch - Store 2"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="not cost_expense_mismatch">
                        <strong>Cost mismatch.</strong> Acquisition Cost differs from the
                        Source Expense amount. Review before posting.
                    </div>
                    <notebook>
                        <page string="Inventory" name="inventory">
                            <group>
                                <group string="Stock">
                                    <field name="product_id"/>
                                    <field name="lot_id"/>
                                    <field name="current_location_id"/>
                                    <field name="on_hand_qty"/>
                                    <field name="in_inventory"/>
                                </group>
                                <group string="Custody Lock">
                                    <field name="locked_to_id"/>
                                </group>
                            </group>
                            <div class="text-muted" invisible="in_inventory">
                                This asset is not yet mirrored into Inventory. It will
                                be created automatically the first time you Move to
                                Store or Transfer it.
                            </div>
                        </page>
                        <page string="Transfer" name="transfer"
                              invisible="state not in ('transferred',) and not transfer_partner_id">
                            <group>
                                <field name="transfer_partner_id" readonly="1"/>
                                <field name="transfer_to" readonly="1"/>
                                <field name="transfer_location_id" readonly="1"/>
                                <field name="transfer_date" readonly="1"/>
                                <field name="transfer_reference" readonly="1"/>
                            </group>
                        </page>
                        <page string="Disposal / Loss" name="disposal"
                              invisible="state not in ('disposed','lost')">
                            <group string="Disposal" invisible="state != 'disposed'">
                                <field name="disposal_method" readonly="1"/>
                                <field name="disposal_date" readonly="1"/>
                                <field name="disposal_value" readonly="1"/>
                                <field name="disposal_reference" readonly="1"/>
                                <field name="disposal_move_id" readonly="1"/>
                            </group>
                            <group string="Loss" invisible="state != 'lost'">
                                <field name="lost_date" readonly="1"/>
                                <field name="lost_reason" readonly="1"/>
                            </group>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"
                                   placeholder="Specification, condition, accessories..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_mcit_asset_search" model="ir.ui.view">
        <field name="name">mcit.asset.search</field>
        <field name="model">mcit.asset</field>
        <field name="arch" type="xml">
            <search string="Search Assets">
                <field name="name" string="Asset"
                       filter_domain="['|', ('name','ilike',self), ('code','ilike',self)]"/>
                <field name="grant_id"/>
                <field name="custodian_id"/>
                <field name="serial_number" placeholder="Search by serial / VIN / chassis number…"/>
                <filter name="active_assets" string="Active"
                        domain="[('state','not in',('disposed','lost'))]"/>
                <filter name="in_use" string="In Use" domain="[('state','=','in_use')]"/>
                <filter name="in_store" string="In Store" domain="[('state','=','in_store')]"/>
                <filter name="transferred" string="Transferred"
                        domain="[('state','=','transferred')]"/>
                <separator/>
                <filter name="disposed" string="Disposed" domain="[('state','=','disposed')]"/>
                <filter name="lost" string="Lost" domain="[('state','=','lost')]"/>
                <group expand="0" string="Group By">
                    <filter name="g_grant" string="Grant" context="{'group_by':'grant_id'}"/>
                    <filter name="g_donor" string="Donor" context="{'group_by':'donor_id'}"/>
                    <filter name="g_cat" string="Category" context="{'group_by':'category'}"/>
                    <filter name="g_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="g_cust" string="Custodian" context="{'group_by':'custodian_id'}"/>
                </group>
                <searchpanel>
                    <field name="state" icon="fa-flag" select="one" enable_counters="1"/>
                    <field name="category" icon="fa-tags" select="multi" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="action_mcit_asset" model="ir.actions.act_window">
        <field name="name">Asset Register</field>
        <field name="res_model">mcit.asset</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active_assets': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register a grant-funded asset</p>
            <p>Track equipment and vehicles bought with donor funds, their custodians,
                their Inventory location, and their transfer/disposal history.
            </p>
        </field>
    </record>

</odoo>
