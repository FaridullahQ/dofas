<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         LIST VIEW
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_arcs_advance_tree" model="ir.ui.view">
        <field name="name">arcs.advance.tree</field>
        <field name="model">arcs.advance</field>
        <field name="arch" type="xml">
            <tree
                    decoration-info="state=='issued'"
                    decoration-success="state=='closed'"
                    decoration-muted="state=='cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="advance_type"/>
                <field name="zone_id" optional="show"/>
                <field name="holder_user_id" optional="hide"/>
                <field name="employee_id" optional="show"/>
                <field name="department_id" optional="show"/>
                <field name="job_id" string="Position" optional="show"/>
                <field name="partner_id" optional="hide"/>
                <field name="grant_id" optional="hide"/>
                <field name="amount" sum="Sent"/>
                <field name="reported_amount" sum="Reported"/>
                <field name="returned_amount" sum="Returned" optional="hide"/>
                <field name="outstanding_amount" sum="Outstanding"/>
                <field name="currency_id" invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state=='issued'"
                       decoration-success="state=='closed'"
                       decoration-danger="state=='cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         FORM VIEW
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_arcs_advance_form" model="ir.ui.view">
        <field name="name">arcs.advance.form</field>
        <field name="model">arcs.advance</field>
        <field name="arch" type="xml">
            <form string="Advance">
                <header>
                    <button name="action_issue" string="Issue Advance" type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"
                            groups="arcs_base.group_finance_manager"
                            help="Disburse the advance to the holder. A journal entry will be posted if ledger booking is enabled."
                            confirm="Issuing this advance will disburse cash to the holder and post a journal entry if ledger booking is enabled. Do you want to continue?"/>
                    <button name="action_close" string="Close" type="object"
                            invisible="state != 'issued'"
                            groups="arcs_base.group_finance_manager"
                            help="Mark this advance as fully settled. Outstanding must be exactly zero first."
                            confirm="Closing this advance marks it as fully settled and prevents any further liquidations or returns from being recorded against it. Do you want to continue?"/>
                    <button name="action_open_settlement_wizard" string="Settle Advance" type="object"
                            class="oe_highlight" icon="fa-exchange"
                            invisible="state != 'issued' or not outstanding_amount"
                            groups="arcs_base.group_finance_manager"
                            help="Record the holder returning unused cash, or being reimbursed for having spent more than the advance - with a real journal entry through a chosen bank/cash journal, backed by a required slip."/>
                    <button name="action_create_liquidation" string="Create Liquidation" type="object"
                            class="oe_highlight"
                            invisible="state != 'issued'"
                            help="Open a new liquidation report for this advance, pre-linked to it."/>
                    <button name="action_cancel_wizard" string="Cancel" type="object"
                            invisible="state in ('closed','cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,issued,closed"/>
                </header>

                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <field name="move_id" invisible="1"/>
                        <button name="action_view_move" type="object"
                                class="oe_stat_button" icon="fa-book"
                                invisible="not move_id"
                                help="View the accounting journal entry created when this advance was issued.">
                            <span class="o_stat_text">Issuance Entry</span>
                        </button>
                        <button name="action_view_liquidations" type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="liquidation_count == 0"
                                help="View all liquidations submitted against this advance.">
                            <field name="liquidation_count" widget="statinfo" string="Liquidations"/>
                        </button>
                    </div>

                    <!-- Title -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"
                                   help="Auto-generated reference number for this advance."/>
                        </h1>
                    </div>

                    <!-- Main Fields -->
                    <group>
                        <!-- Left: Recipient -->
                        <group string="Recipient &amp; Holder"
                               help="Identifies who receives the advance and who is financially accountable.">
                            <field name="advance_type"
                                   help="Region/Province: advance managed by a field office team.&#10;Employee/Staff: advance issued directly to an individual who becomes the debtor."
                                   readonly="state != 'draft'"/>
                            <field name="zone_id"
                                   invisible="advance_type != 'zone'"
                                   required="advance_type == 'zone'"
                                   placeholder="Select zone or province…"
                                   help="The field office or province receiving this advance. The zone manager is automatically suggested as the Holder."
                                   readonly="state != 'draft'"/>
                            <field name="holder_user_id"
                                   invisible="advance_type != 'employee'"
                                   help="Derived automatically from Employee below when it has a linked user; kept editable in case it doesn't or a different login should be the record-rule holder."
                                   readonly="state != 'draft'"/>
                            <field name="employee_id"
                                   invisible="advance_type != 'employee'"
                                   required="advance_type == 'employee'"
                                   placeholder="Search for an employee…"
                                   help="The employee who will hold and be accountable for this advance. Selecting one automatically fills in their Holder (linked user) and debtor Partner, and surfaces their Department/Position for reporting."
                                   readonly="state != 'draft'"/>
                            <field name="department_id" invisible="advance_type != 'employee'" readonly="1"/>
                            <field name="job_id" invisible="advance_type != 'employee'" readonly="1"/>
                            <field name="partner_id"
                                   placeholder="Select or confirm the debtor partner…"
                                   help="The partner (contact/employee) linked in the accounting ledger for this advance. For employee advances this is pre-filled from the selected user. This partner will appear on the journal entry lines."
                                   readonly="state != 'draft'"/>
                            <field name="date"
                                   help="Disbursement date. Used for currency conversion rates and journal entry dating."
                                   readonly="state != 'draft'"/>
                            <field name="reference"
                                   placeholder="e.g. PV-2024-001, Cheque #12345, Transfer REF…"
                                   help="External payment reference such as a voucher number, cheque number, or bank transfer reference for reconciliation and audit purposes."
                                   readonly="state != 'draft'"/>
                        </group>

                        <!-- Right: Funding -->
                        <group string="Funding &amp; Amount"
                               help="Links the advance to a grant/budget line and specifies the disbursed amount.">
                            <field name="grant_id"
                                   placeholder="Select the donor grant…"
                                   help="The donor grant funding this advance. Selecting a grant filters the budget lines below."
                                   readonly="state != 'draft'"/>
                            <field name="budget_line_id"
                                   placeholder="Select a budget line within the grant…"
                                   help="The specific budget line to charge. Only lines belonging to the selected grant are available."
                                   readonly="state != 'draft'"/>
                            <field name="currency_id"
                                   help="Currency in which cash is disbursed. The system converts to the company currency when posting journal entries."
                                   readonly="state != 'draft'"/>
                            <field name="amount"
                                   help="Total cash amount handed to the holder. Must be greater than zero to issue the advance."
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <!-- Tracking Summary -->
                    <group string="Financial Tracking" col="4">
                        <field name="reported_amount"
                               help="Total value of approved/posted liquidations — expenses already justified and accepted by finance."/>
                        <field name="returned_amount"
                               help="Cash physically returned by the holder. Enter directly, or use Settle Advance for a version backed by a real journal entry and a required slip."
                               readonly="state == 'closed' or state == 'cancelled'"/>
                        <field name="reimbursed_amount"
                               help="Cash paid back to the holder for having spent more than the advance (only relevant when Allow Liquidation Above Advance is on). Set via Settle Advance."
                               readonly="1"/>
                        <field name="outstanding_amount"
                               help="Amount Sent + Reimbursed − Reported − Returned. Positive: still to account for. Negative: the holder is owed a reimbursement. Must reach exactly zero to close."/>
                        <field name="cash_balance"
                               help="Same as Outstanding, shown as the cash currently in the holder's hands."/>
                        <field name="allow_over_liquidation"
                               readonly="state != 'draft'"/>
                    </group>

                    <!-- Tabs -->
                    <notebook>
                        <page string="Liquidations" name="liq">
                            <field name="liquidation_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state in ('submitted','approved')"
                                           decoration-success="state=='posted'"
                                           decoration-danger="state=='cancelled'"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"
                                   placeholder="Add the purpose of this advance, special conditions, liquidation deadline, or any other relevant instructions for the holder…"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>


    <!-- ═══════════════════════════════════════════════════════════════════
         SEARCH VIEW
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_arcs_advance_search" model="ir.ui.view">
        <field name="name">arcs.advance.search</field>
        <field name="model">arcs.advance</field>
        <field name="arch" type="xml">
            <search string="Search Advances">
                <field name="name" string="Reference" filter_domain="[('name','ilike',self)]"/>
                <field name="zone_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="job_id" string="Position"/>
                <field name="holder_user_id"/>
                <field name="partner_id"/>
                <field name="grant_id"/>
                <field name="reference" string="Payment Ref" placeholder="Search by payment reference…"/>
                <!-- Status Filters -->
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="issued" string="Issued" domain="[('state','=','issued')]"/>
                <filter name="open_outstanding" string="Has Outstanding Balance"
                        domain="[('outstanding_amount','>',0),('state','=','issued')]"/>
                <filter name="closed" string="Closed" domain="[('state','=','closed')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <!-- Type Filters -->
                <filter name="zone_adv" string="Region Advances" domain="[('advance_type','=','zone')]"/>
                <filter name="emp_adv" string="Employee Advances" domain="[('advance_type','=','employee')]"/>
                <!-- Group By -->
                <group expand="0" string="Group By">
                    <filter name="g_zone" string="Region" context="{'group_by':'zone_id'}"/>
                    <filter name="g_employee" string="Employee" context="{'group_by':'employee_id'}"/>
                    <filter name="g_department" string="Department" context="{'group_by':'department_id'}"/>
                    <filter name="g_job" string="Position" context="{'group_by':'job_id'}"/>
                    <filter name="g_partner" string="Partner" context="{'group_by':'partner_id'}"/>
                    <filter name="g_type" string="Type" context="{'group_by':'advance_type'}"/>
                    <filter name="g_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="g_grant" string="Grant" context="{'group_by':'grant_id'}"/>
                    <filter name="g_date" string="Month" context="{'group_by':'date:month'}"/>
                </group>
                <searchpanel>
                    <field name="state" icon="fa-flag" select="one" enable_counters="1"/>
                    <field name="advance_type" icon="fa-tag" select="one" enable_counters="1"/>
                    <field name="department_id" icon="fa-building" select="multi" enable_counters="1"/>
                    <field name="zone_id" icon="fa-map-marker" select="multi" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <!-- ═══════════════════════════════════════════════════════════════════
         PIVOT & GRAPH VIEWS
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_arcs_advance_pivot" model="ir.ui.view">
        <field name="name">arcs.advance.pivot</field>
        <field name="model">arcs.advance</field>
        <field name="arch" type="xml">
            <pivot string="Advance Tracking">
                <field name="department_id" type="row"/>
                <field name="employee_id" type="row"/>
                <field name="job_id" type="row"/>
                <field name="zone_id" type="row"/>
                <field name="partner_id" type="row"/>
                <field name="amount" type="measure"/>
                <field name="reported_amount" type="measure"/>
                <field name="returned_amount" type="measure"/>
                <field name="reimbursed_amount" type="measure"/>
                <field name="outstanding_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_arcs_advance_graph" model="ir.ui.view">
        <field name="name">arcs.advance.graph</field>
        <field name="model">arcs.advance</field>
        <field name="arch" type="xml">
            <graph string="Advance Tracking" type="bar">
                <field name="zone_id"/>
                <field name="outstanding_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         ACTIONS
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="action_arcs_advance" model="ir.actions.act_window">
        <field name="name">Advances</field>
        <field name="res_model">arcs.advance</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No advances found
            </p>
            <p>
                Create a new advance to disburse cash to a zone/province or to a staff member
                who becomes the accountable holder.
            </p>
        </field>
    </record>

    <record id="action_arcs_advance_tracking" model="ir.actions.act_window">
        <field name="name">Advance Tracking</field>
        <field name="res_model">arcs.advance</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="domain">[('state','=','issued')]</field>
        <field name="context">{'search_default_g_zone': 1}</field>
    </record>

    <record id="action_arcs_employee_advance" model="ir.actions.act_window">
        <field name="name">Employee Advances</field>
        <field name="res_model">arcs.advance</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="domain">[('advance_type', '=', 'employee')]</field>
        <field name="context">{'default_advance_type': 'employee', 'search_default_g_department': 1}</field>
        <field name="search_view_id" ref="view_arcs_advance_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No employee advances found
            </p>
            <p>
                Every employee with an advance in progress or completed, grouped by
                department by default - their Position and Department come straight
                from their Employee record, alongside the advance amount, what
                they've justified so far, and what's still outstanding.
            </p>
        </field>
    </record>

</odoo>
