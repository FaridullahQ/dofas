<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         LIST VIEW
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_arcs_liq_tree" model="ir.ui.view">
        <field name="name">arcs.advance.liquidation.tree</field>
        <field name="model">arcs.advance.liquidation</field>
        <field name="arch" type="xml">
            <tree
                    decoration-info="state in ('submitted','approved')"
                    decoration-success="state=='posted'"
                    decoration-muted="state=='cancelled'">
                <field name="name"/>
                <field name="advance_id"/>
                <field name="holder_user_id" optional="show"/>
                <field name="zone_id" optional="show"/>
                <field name="date"/>
                <field name="advance_amount" string="Advance Total" optional="hide"/>
                <field name="amount" sum="Liquidated"/>
                <field name="currency_id" invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('submitted','approved')"
                       decoration-success="state=='posted'"
                       decoration-danger="state=='cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         FORM VIEW
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_arcs_liq_form" model="ir.ui.view">
        <field name="name">arcs.advance.liquidation.form</field>
        <field name="model">arcs.advance.liquidation</field>
        <field name="arch" type="xml">
            <form string="Advance Liquidation">
                <header>
                    <button name="action_submit" string="Submit for Approval" type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"
                            help="Submit this liquidation to the Finance Manager for review. Ensure all justified expenses are added and the total does not exceed your advance balance."
                            confirm="Submitting this liquidation will send it to the Finance Manager for review and lock it from further edits. Do you want to continue?"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="oe_highlight"
                            invisible="state != 'submitted'"
                            groups="arcs_base.group_finance_manager"
                            help="Approve the justified expenses. The liquidation can then be posted to the accounting ledger."
                            confirm="Approving this liquidation confirms the justified expenses are valid and ready to be posted to the ledger. Do you want to continue?"/>
                    <button name="action_post" string="Post to Ledger" type="object"
                            class="oe_highlight"
                            invisible="state != 'approved'"
                            groups="arcs_base.group_finance_manager"
                            help="Post a journal entry: Dr Clearing Account / Cr Advance Receivable (with partner), reducing the holder's outstanding debt."
                            confirm="Posting this liquidation will create a journal entry and reduce the holder's outstanding advance debt. Do you want to continue?"/>
                    <button name="action_reset_draft_wizard" string="Reset to Draft" type="object"
                            invisible="state not in ('submitted','approved')"/>
                    <button name="action_cancel_wizard" string="Cancel" type="object"
                            invisible="state in ('posted','cancelled')"
                            groups="arcs_base.group_finance_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,posted"/>
                </header>

                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <field name="move_id" invisible="1"/>
                        <button name="action_view_move" type="object"
                                class="oe_stat_button" icon="fa-book"
                                invisible="not move_id"
                                help="View the accounting journal entry that cleared this liquidation.">
                            <span class="o_stat_text">Liquidation Entry</span>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"
                                   help="Auto-generated liquidation reference number."/>
                        </h1>
                    </div>

                    <group>
                        <!-- Left: Advance Reference -->
                        <group string="Advance Reference">
                            <field name="advance_id"
                                   placeholder="Select your issued advance…"
                                   help="The advance you are settling. Only advances in 'Issued' state assigned to you are shown. The total expenses you attach must not exceed the available balance shown below."
                                   readonly="state != 'draft'"/>
                            <field name="holder_user_id"
                                   help="The staff member holding this advance. Derived automatically from the linked advance. This person is financially accountable for the advance."
                                   readonly="1"/>
                            <field name="partner_id"
                                   help="Accounting partner — used on the journal entry lines to reduce the holder's advance receivable balance to zero. Derived from the linked advance."
                                   readonly="1"/>
                            <field name="zone_id"
                                   help="Region or province from the linked advance."
                                   readonly="1"/>
                            <field name="date"
                                   help="Date the expenses were incurred or this report was prepared."
                                   readonly="state != 'draft'"/>
                        </group>

                        <!-- Right: Financial Summary -->
                        <group string="Financial Summary">
                            <field name="advance_amount"
                                   help="Total cash originally issued in the linked advance."/>
                            <field name="advance_available"
                                   help="Remaining balance available for this liquidation. Computed as: Advance Amount − Cash Returned − All other active liquidations. Your expenses must not exceed this ceiling."
                                   decoration-danger="amount &gt; advance_available"/>
                            <field name="amount"
                                   help="Total of all linked justified expenses. Computed automatically. Must not exceed the Available to Liquidate ceiling above."/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <!-- Over-limit inline warning -->
                    <div invisible="amount &lt;= advance_available or not advance_id"
                         style="margin-bottom:12px;">
                        <div class="alert alert-danger" role="alert">
                            <i class="fa fa-exclamation-triangle"/>
                            <strong>Over advance ceiling:</strong>
                            The total expenses exceed the available balance on this advance.
                            Remove some expenses or adjust the amounts before submitting.
                        </div>
                    </div>

                    <!-- Tabs -->
                    <notebook>
                        <page string="Justified Expenses" name="exp">
                            <field name="expense_ids"
                                   help="Attach the posted expense records that justify the use of advance cash. Only expenses in 'Posted' state are eligible. The sum must not exceed the advance's Available to Liquidate balance."
                                   readonly="state != 'draft'"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"
                                   placeholder="Describe the nature of expenses, explain any unusual items, or add notes for the approver — e.g. 'Hotel receipt delayed, will follow up' or 'Fuel costs per field log attached'."
                                   readonly="state not in ('draft', 'submitted')"/>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <!-- ═══════════════════════════════════════════════════════════════════
         SEARCH VIEW
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_arcs_liq_search" model="ir.ui.view">
        <field name="name">arcs.advance.liquidation.search</field>
        <field name="model">arcs.advance.liquidation</field>
        <field name="arch" type="xml">
            <search string="Search Liquidations">
                <field name="name" string="Reference" placeholder="Search by liquidation reference…"/>
                <field name="advance_id"/>
                <field name="holder_user_id"/>
                <field name="zone_id"/>
                <filter name="my_liquidations" string="My Liquidations"
                        domain="[('holder_user_id','=',uid)]"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="posted" string="Posted" domain="[('state','=','posted')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="pending_review" string="Pending Finance Review"
                        domain="[('state','in',('submitted','approved'))]"/>
                <group expand="0" string="Group By">
                    <filter name="g_holder" string="Holder" context="{'group_by':'holder_user_id'}"/>
                    <filter name="g_advance" string="Advance" context="{'group_by':'advance_id'}"/>
                    <filter name="g_zone" string="Region" context="{'group_by':'zone_id'}"/>
                    <filter name="g_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="g_date" string="Month" context="{'group_by':'date:month'}"/>
                </group>
                <searchpanel>
                    <field name="state" icon="fa-flag" select="one" enable_counters="1"/>
                    <field name="zone_id" icon="fa-map-marker" select="multi" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <!-- ═══════════════════════════════════════════════════════════════════
         ACTION
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="action_arcs_liq" model="ir.actions.act_window">
        <field name="name">Liquidations</field>
        <field name="res_model">arcs.advance.liquidation</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_my_liquidations': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No liquidations found
            </p>
            <p>
                Create a liquidation to justify expenses against one of your issued advances.
                The total expenses cannot exceed the advance's available balance.
            </p>
        </field>
    </record>

</odoo>
