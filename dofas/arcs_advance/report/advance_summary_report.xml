<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_advance_summary" model="ir.actions.report">
        <field name="name">Cash Advance Summary</field>
        <field name="model">arcs.advance</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">arcs_advance.report_advance_summary</field>
        <field name="report_file">arcs_advance.report_advance_summary</field>
        <field name="print_report_name">'Advance Summary - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_arcs_advance"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_advance_summary">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-call="arcs_base.report_voucher_document"/>
                </t>
            </t>
        </t>
    </template>
</odoo>
