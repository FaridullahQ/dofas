<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Expense analysis: actual spend by grant / line / month -->
    <record id="view_mcit_expense_pivot" model="ir.ui.view">
        <field name="name">mcit.expense.pivot</field><field name="model">mcit.expense</field>
        <field name="arch" type="xml">
            <pivot string="Expenditure Analysis">
                <field name="grant_id" type="row"/>
                <field name="budget_line_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_mcit_expense_graph" model="ir.ui.view">
        <field name="name">mcit.expense.graph</field><field name="model">mcit.expense</field>
        <field name="arch" type="xml">
            <graph string="Expenditure" type="bar">
                <field name="grant_id"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="action_mcit_expense_analysis" model="ir.actions.act_window">
        <field name="name">Expenditure Analysis</field>
        <field name="res_model">mcit.expense</field>
        <field name="view_mode">graph,pivot,tree</field>
        <field name="domain">[('state','=','posted')]</field>
    </record>

    <!-- Budget monitoring: planned vs committed vs actual vs available -->
    <record id="view_mcit_budget_line_pivot" model="ir.ui.view">
        <field name="name">mcit.budget.line.pivot</field><field name="model">mcit.budget.line</field>
        <field name="arch" type="xml">
            <pivot string="Budget Monitoring">
                <field name="grant_id" type="row"/>
                <field name="planned_amount" type="measure"/>
                <field name="committed_amount" type="measure"/>
                <field name="actual_amount" type="measure"/>
                <field name="available_amount" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_mcit_budget_monitor" model="ir.actions.act_window">
        <field name="name">Budget Monitoring</field>
        <field name="res_model">mcit.budget.line</field>
        <field name="view_mode">pivot,tree</field>
    </record>

    <!-- Commitments analysis -->
    <record id="view_mcit_commitment_graph" model="ir.ui.view">
        <field name="name">mcit.commitment.graph</field><field name="model">mcit.commitment</field>
        <field name="arch" type="xml">
            <graph string="Commitments" type="bar">
                <field name="grant_id"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="action_mcit_commitment_analysis" model="ir.actions.act_window">
        <field name="name">Commitment Analysis</field>
        <field name="res_model">mcit.commitment</field>
        <field name="view_mode">graph,tree</field>
        <field name="domain">[('state','=','confirmed')]</field>
    </record>
</odoo>
