<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcit_advance_config_settings" model="ir.ui.view">
        <field name="name">mcit.advance.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mcit_base.view_mcit_config_settings"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='mcit_donor_management']" position="inside">
                <block title="Advances" name="mcit_advance_block">
                    <setting string="Book advances to the ledger" help="Post journal entries when advances are issued and liquidated.">
                        <field name="mcit_advance_book"/>
                    </setting>
                    <setting string="Advance Journal" invisible="not mcit_advance_book">
                        <field name="mcit_advance_journal_id"/>
                    </setting>
                    <setting string="Advance (Receivable) Account" invisible="not mcit_advance_book">
                        <field name="mcit_advance_account_id"/>
                    </setting>
                    <setting string="Cash/Bank Account" invisible="not mcit_advance_book">
                        <field name="mcit_advance_cash_account_id"/>
                    </setting>
                    <setting string="Clearing Account" invisible="not mcit_advance_book">
                        <field name="mcit_advance_clearing_account_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
