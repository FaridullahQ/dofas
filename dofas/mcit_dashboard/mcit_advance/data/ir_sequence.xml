<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_mcit_advance" model="ir.sequence">
            <field name="name">MCIT Advance</field>
            <field name="code">mcit.advance</field>
            <field name="prefix">ADV/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_mcit_advance_liquidation" model="ir.sequence">
            <field name="name">MCIT Advance Liquidation</field>
            <field name="code">mcit.advance.liquidation</field>
            <field name="prefix">LIQ/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
