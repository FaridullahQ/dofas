<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcit_closure_form" model="ir.ui.view">
        <field name="name">mcit.project.closure.form</field><field name="model">mcit.project.closure</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_verify" string="Verify" type="object" class="oe_highlight" invisible="state!='draft'"/>
                    <button name="action_approve" string="Approve Closure" type="object" class="oe_highlight" invisible="state!='verified'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,verified,approved"/>
                </header>
                <sheet>
                    <group><group><field name="name"/><field name="grant_id"/></group></group>
                    <group string="Verification">
                        <field name="all_expenses_posted"/>
                        <field name="all_reports_approved"/>
                    </group>
                    <group string="Final Balance">
                        <field name="received_total"/>
                        <field name="actual_total"/>
                        <field name="remaining_balance"/>
                        <field name="returned_amount"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter"><field name="message_ids"/></div>
            </form>
        </field>
    </record>
    <record id="view_mcit_closure_tree" model="ir.ui.view">
        <field name="name">mcit.project.closure.tree</field><field name="model">mcit.project.closure</field>
        <field name="arch" type="xml"><tree><field name="name"/><field name="grant_id"/><field name="currency_id" column_invisible="1"/><field name="remaining_balance"/><field name="returned_amount"/><field name="state" widget="badge"/></tree></field>
    </record>
    <record id="action_mcit_closure" model="ir.actions.act_window">
        <field name="name">Project Closures</field><field name="res_model">mcit.project.closure</field><field name="view_mode">tree,form</field>
    </record>
</odoo>
