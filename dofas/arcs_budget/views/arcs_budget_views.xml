<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_arcs_budget_form" model="ir.ui.view">
        <field name="name">arcs.budget.form</field>
        <field name="model">arcs.budget</field>
        <field name="arch" type="xml">
            <form string="Budget">
                <header>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight"
                            invisible="state!='draft'"
                            confirm="Approving this budget will lock its lines from further edits and make it the active budget for this grant. Do you want to continue?"/>
                    <button name="action_create_revision" string="Create Revision" type="object"
                            invisible="state!='approved'"
                            confirm="Creating a revision will generate a new draft version of this budget for editing, based on the current approved version. Do you want to continue?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="grant_id" readonly="state!='draft'"/>
                            <field name="version" readonly="state!='draft'"/>
                        </group>
                        <group>
                            <field name="currency_id" readonly="state!='draft'"/>
                            <field name="planned_total"/>
                            <field name="available_total"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state!='draft'">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name" placeholder="e.g. Salaries"/>
                            <field name="category"/>
                            <field name="account_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="planned_amount" sum="Planned"/>
                            <field name="transferred_in_amount" sum="Transferred In" optional="show"/>
                            <field name="transferred_out_amount" sum="Transferred Out" optional="show"/>
                            <field name="effective_planned_amount" sum="Net Planned" optional="show"/>
                            <field name="committed_amount" sum="Committed"/>
                            <field name="actual_amount" sum="Actual"/>
                            <field name="available_amount" sum="Available"/>
                            <field name="utilization" optional="show"/>
                        </tree>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_arcs_budget_tree" model="ir.ui.view">
        <field name="name">arcs.budget.tree</field>
        <field name="model">arcs.budget</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state in ('draft','superseded')" decoration-success="state=='approved'">
                <field name="name"/>
                <field name="grant_id"/>
                <field name="version"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="planned_total"/>
                <field name="available_total"/>
                <field name="state" widget="badge"
                       decoration-muted="state in ('draft','superseded')"
                       decoration-success="state=='approved'"/>
            </tree>
        </field>
    </record>
    <record id="view_arcs_budget_search" model="ir.ui.view">
        <field name="name">arcs.budget.search</field>
        <field name="model">arcs.budget</field>
        <field name="arch" type="xml">
            <search string="Search Budgets">
                <field name="name" placeholder="Search by budget name…"/>
                <field name="grant_id"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="superseded" string="Superseded" domain="[('state','=','superseded')]"/>
                <group expand="0" string="Group By">
                    <filter name="g_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="g_grant" string="Grant" context="{'group_by':'grant_id'}"/>
                </group>
                <searchpanel>
                    <field name="state" icon="fa-flag" select="one" enable_counters="1"/>
                    <field name="grant_id" icon="fa-money" select="multi" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="action_arcs_budget" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">arcs.budget</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_arcs_budget_search"/>
    </record>

    <record id="view_arcs_commitment_tree" model="ir.ui.view">
        <field name="name">arcs.commitment.tree</field>
        <field name="model">arcs.commitment</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false"
                  decoration-info="state=='confirmed'" decoration-success="state=='consumed'"
                  decoration-muted="state=='released'">
                <field name="create_date"/>
                <field name="grant_id"/>
                <field name="budget_line_id"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount" sum="Committed"/>
                <field name="source_ref" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state=='confirmed'" decoration-success="state=='consumed'"
                       decoration-muted="state=='released'"/>
            </tree>
        </field>
    </record>
    <record id="view_arcs_commitment_search" model="ir.ui.view">
        <field name="name">arcs.commitment.search</field>
        <field name="model">arcs.commitment</field>
        <field name="arch" type="xml">
            <search string="Search Commitments">
                <field name="grant_id"/>
                <field name="budget_line_id"/>
                <field name="source_ref" placeholder="Search by source reference…"/>
                <separator/>
                <filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/>
                <filter name="consumed" string="Consumed" domain="[('state','=','consumed')]"/>
                <filter name="released" string="Released" domain="[('state','=','released')]"/>
                <group expand="0" string="Group By">
                    <filter name="g_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="g_grant" string="Grant" context="{'group_by':'grant_id'}"/>
                    <filter name="g_line" string="Budget Line" context="{'group_by':'budget_line_id'}"/>
                </group>
                <searchpanel>
                    <field name="state" icon="fa-flag" select="one" enable_counters="1"/>
                    <field name="grant_id" icon="fa-money" select="multi" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="action_arcs_commitment" model="ir.actions.act_window">
        <field name="name">Commitments</field>
        <field name="res_model">arcs.commitment</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="view_arcs_commitment_search"/>
    </record>
</odoo>
