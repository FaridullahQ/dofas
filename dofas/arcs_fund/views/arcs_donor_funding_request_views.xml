<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_arcs_donor_funding_request_tree" model="ir.ui.view">
        <field name="name">arcs.donor.funding.request.tree</field>
        <field name="model">arcs.donor.funding.request</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state in ('draft','cancelled')" decoration-info="state=='requested'"
                  decoration-success="state=='approved'" decoration-danger="state=='rejected'">
                <field name="name"/>
                <field name="grant_id"/>
                <field name="donor_id"/>
                <field name="amount_requested" sum="Total"/>
                <field name="amount_approved" sum="Confirmed" optional="show"/>
                <field name="currency_id" invisible="1"/>
                <field name="state" widget="badge"
                       decoration-muted="state in ('draft','cancelled')" decoration-info="state=='requested'"
                       decoration-success="state=='approved'" decoration-danger="state=='rejected'"/>
            </tree>
        </field>
    </record>

    <record id="view_arcs_donor_funding_request_form" model="ir.ui.view">
        <field name="name">arcs.donor.funding.request.form</field>
        <field name="model">arcs.donor.funding.request</field>
        <field name="arch" type="xml">
            <form string="Donor Supplementary Funding Request">
                <header>
                    <button name="action_request" string="Send to Donor" type="object"
                            class="oe_highlight" invisible="state != 'draft'"
                            confirm="Sending this request will notify the donor and lock its details from further edits. Do you want to continue?"/>
                    <button name="action_open_send_wizard" string="Send Email" type="object"
                            class="btn-secondary" icon="fa-envelope-o"
                            invisible="state != 'requested'"/>
                    <button name="action_donor_approve" string="Record Donor Approval" type="object"
                            class="oe_highlight" invisible="state != 'requested'"
                            groups="arcs_base.group_finance_officer"
                            confirm="This records that the donor has approved the supplementary funding. Make sure the Amount Confirmed, decision date and note are filled in, and the bank receipt is attached, first. Do you want to continue?"/>
                    <button name="action_donor_reject_wizard" string="Record Donor Rejection" type="object"
                            invisible="state != 'requested'"
                            groups="arcs_base.group_finance_officer"/>
                    <button name="action_cancel_wizard" string="Cancel" type="object"
                            invisible="state not in ('draft', 'requested')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,requested,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="email_sent" invisible="1"/>
                        <div class="oe_stat_button" invisible="not email_sent">
                            <i class="fa fa-fw fa-envelope"/>
                            <div class="o_stat_info">
                                <span class="o_stat_text">Emailed</span>
                                <field name="email_sent_date" widget="date"
                                       class="o_stat_text" readonly="1"/>
                            </div>
                        </div>
                    </div>

                    <!-- bank receipt attachment gate -->
                    <field name="bank_receipt_attached" invisible="1"/>
                    <field name="attachment_count" invisible="1"/>
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'requested' or bank_receipt_attached">
                        <strong>Bank receipt required.</strong>
                        Attach the donor's bank receipt in the chatter (paperclip icon below)
                        and confirm the Amount Confirmed before recording the donor's approval.
                    </div>
                    <div class="alert alert-success" role="alert"
                         invisible="state != 'requested' or not bank_receipt_attached">
                        <strong>Bank receipt attached.</strong>
                        <field name="attachment_count" class="oe_inline"/>
                        document(s) attached. Confirm the Amount Confirmed, then you may
                        record the donor's approval.
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Grant &amp; Donor">
                            <field name="grant_id" placeholder="Select the grant..."
                                   readonly="state != 'draft'"
                                   help="The grant whose donor will be asked for supplementary funds."/>
                            <field name="donor_id"/>
                        </group>
                        <group string="Amount">
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_requested" placeholder="0.00" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Justification" col="1">
                        <field name="reason" nolabel="1" readonly="state != 'draft'"
                               placeholder="Why is supplementary funding needed? e.g. cover a shortfall on..."/>
                    </group>
                    <group string="Donor Decision" invisible="state not in ('requested', 'approved', 'rejected')">
                        <field name="amount_approved" readonly="state != 'requested'"/>
                        <field name="decision_date" readonly="1"/>
                        <field name="decision_note" placeholder="Donor's decision, notes, references..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_arcs_donor_funding_request_search" model="ir.ui.view">
        <field name="name">arcs.donor.funding.request.search</field>
        <field name="model">arcs.donor.funding.request</field>
        <field name="arch" type="xml">
            <search string="Search Donor Funding Requests">
                <field name="name" string="Request"
                       filter_domain="['|',('name','ilike',self),('reason','ilike',self)]"/>
                <field name="grant_id"/>
                <field name="donor_id"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="requested" string="Requested" domain="[('state','=','requested')]"/>
                <filter name="approved" string="Donor Approved" domain="[('state','=','approved')]"/>
                <filter name="rejected" string="Donor Rejected" domain="[('state','=','rejected')]"/>
                <group expand="0" string="Group By">
                    <filter name="g_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="g_donor" string="Donor" context="{'group_by':'donor_id'}"/>
                    <filter name="g_grant" string="Grant" context="{'group_by':'grant_id'}"/>
                </group>
                <searchpanel>
                    <field name="state" icon="fa-flag" select="one" enable_counters="1"/>
                    <field name="donor_id" icon="fa-heart" select="multi" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="action_arcs_donor_funding_request" model="ir.actions.act_window">
        <field name="name">Donor Supplementary Funding</field>
        <field name="res_model">arcs.donor.funding.request</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_arcs_donor_funding_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ask a donor for supplementary funding</p>
            <p>Track a request for additional funds on a grant, and record the donor's decision once received.</p>
        </field>
    </record>
</odoo>
