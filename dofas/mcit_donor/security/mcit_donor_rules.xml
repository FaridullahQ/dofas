<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ═══════════════════════════════════════════════════════════
         DONOR — Donor Officers are scoped to their Managed Donors.
         System Administrators implicitly inherit group_donor_officer
         (see mcit_base group implied_ids), so they get an explicit
         unrestricted bypass rule below - without it they would also
         be scoped down to Managed Donors.
    ═══════════════════════════════════════════════════════════════ -->
    <record id="rule_mcit_donor_officer_scope" model="ir.rule">
        <field name="name">mcit.donor — Donor Officer sees only Managed Donors</field>
        <field name="model_id" ref="model_mcit_donor"/>
        <field name="groups" eval="[(4, ref('mcit_base.group_donor_officer'))]"/>
        <field name="domain_force">[('id', 'in', user.mcit_donor_ids.ids)]</field>
    </record>

    <record id="rule_mcit_donor_admin_bypass" model="ir.rule">
        <field name="name">mcit.donor — System Admin unrestricted</field>
        <field name="model_id" ref="model_mcit_donor"/>
        <field name="groups" eval="[(4, ref('mcit_base.group_system_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
