<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_mcit_donor_scope" model="ir.ui.view">
        <field name="name">res.users.form.mcit.donor.scope</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="Donor Scope (Donor Officer role)">
                    <field name="mcit_donor_ids" widget="many2many_tags"
                           placeholder="All donors (no restriction if this user is not a Donor Officer)"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
