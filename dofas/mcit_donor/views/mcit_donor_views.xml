<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================ TREE ================================ -->
    <record id="view_mcit_donor_tree" model="ir.ui.view">
        <field name="name">mcit.donor.tree</field>
        <field name="model">mcit.donor</field>
        <field name="arch" type="xml">
            <tree string="Donors" default_order="name"
                  decoration-muted="not active"
                  decoration-bf="donor_type == 'government'">
                <field name="active" column_invisible="1"/>
                <field name="code"/>
                <field name="name"/>
                <field name="donor_type" widget="badge"
                       decoration-info="donor_type in ('multilateral','bilateral')"
                       decoration-success="donor_type == 'foundation'"
                       decoration-warning="donor_type == 'corporate'"/>
                <field name="country_id" optional="show"/>
<!--                <field name="currency_id" optional="show"/>-->
                <field name="reporting_frequency" widget="badge"
                       decoration-info="reporting_frequency in ('monthly','quarterly')"
                       decoration-warning="reporting_frequency == 'final'"
                       optional="show"/>
                <field name="email" widget="email" optional="hide"/>
                <field name="website" widget="url" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- ================================ FORM ================================ -->
    <record id="view_mcit_donor_form" model="ir.ui.view">
        <field name="name">mcit.donor.form</field>
        <field name="model">mcit.donor</field>
        <field name="arch" type="xml">
            <form string="Donor">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. United Nations Development Programme"/></h1>
                        <h3 class="text-muted mt-0">
                            <field name="code" class="oe_inline" placeholder="e.g. UNDP"/>
                        </h3>
                    </div>
                    <!-- Step 1: identify the donor -->
                    <group>
                        <group string="Identification">
                            <field name="donor_type"
                                   help="Category of the funding organization. It influences the default reporting expectations."/>
                            <field name="partner_id"
                                   help="Linked contact / organization record in Contacts (used for addresses and communication)."/>
                        </group>
                        <group string="Origin &amp; Currency">
                            <field name="country_id" options="{'no_create': True}"
                                   help="Country where the donor is headquartered."/>
<!--                            <field name="currency_id" options="{'no_create': True}"-->
                                   help="Currency in which this donor commits and reports funds."/>
                        </group>
                    </group>
                    <!-- Step 2: contact + reporting expectations -->
                    <group>
                        <group string="Contact details">
                            <field name="email" widget="email" placeholder="grants@donor.org"/>
                            <field name="website" widget="url" placeholder="https://www.donor.org"/>
                        </group>
                        <group string="Reporting">
                            <field name="reporting_frequency"
                                   help="Default cadence at which this donor requires narrative and financial reports."/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- =============================== SEARCH =============================== -->
    <record id="view_mcit_donor_search" model="ir.ui.view">
        <field name="name">mcit.donor.search</field>
        <field name="model">mcit.donor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Donor"
                       filter_domain="['|','|',('name','ilike',self),('code','ilike',self),('email','ilike',self)]"/>
                <field name="code"/>
                <field name="country_id"/>
                <field name="donor_type"/>
<!--                <field name="currency_id"/>-->
                <separator/>
                <filter name="gov" string="Government" domain="[('donor_type','=','government')]"/>
                <filter name="multilat" string="Multilateral" domain="[('donor_type','=','multilateral')]"/>
                <filter name="foundations" string="Foundations" domain="[('donor_type','=','foundation')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter name="g_type" string="Donor Type" context="{'group_by':'donor_type'}"/>
                    <filter name="g_country" string="Country" context="{'group_by':'country_id'}"/>
<!--                    <filter name="g_currency" string="Currency" context="{'group_by':'currency_id'}"/>-->
                    <filter name="g_freq" string="Reporting Frequency" context="{'group_by':'reporting_frequency'}"/>
                </group>
                <searchpanel>
                    <field name="donor_type" string="Type" icon="fa-sitemap" enable_counters="1"/>
                    <field name="country_id" string="Country" icon="fa-globe" enable_counters="1" select="multi"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- =============================== ACTION =============================== -->
    <record id="action_mcit_donor" model="ir.actions.act_window">
        <field name="name">Donors</field>
        <field name="res_model">mcit.donor</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_mcit_donor_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first donor</p>
            <p>Capture the organizations that fund your grants — their type, country,
               currency and how often they expect reports.</p>
        </field>
    </record>

</odoo>