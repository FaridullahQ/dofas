<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcit_expense_form_program" model="ir.ui.view">
        <field name="name">mcit.expense.form.program</field>
        <field name="model">mcit.expense</field>
        <field name="inherit_id" ref="mcit_expense.view_mcit_expense_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='budget_line_id']" position="after">
                <field name="project_id"/>
                <field name="activity_id"/>
            </xpath>
        </field>
    </record>
</odoo>
