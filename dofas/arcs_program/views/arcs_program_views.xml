<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================== PROGRAM ============================== -->
    <record id="view_arcs_program_tree" model="ir.ui.view">
        <field name="name">arcs.program.tree</field>
        <field name="model">arcs.program</field>
        <field name="arch" type="xml">
            <tree string="Programs" default_order="name"
                  decoration-muted="not active or state=='closed'" decoration-info="state=='draft'"
                  decoration-success="state=='active'">
                <field name="active" column_invisible="1"/>
                <field name="code"/>
                <field name="name"/>
                <field name="manager_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state=='draft'" decoration-success="state=='active'"
                       decoration-muted="state=='closed'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>
    <record id="view_arcs_program_form" model="ir.ui.view">
        <field name="name">arcs.program.form</field>
        <field name="model">arcs.program</field>
        <field name="arch" type="xml">
            <form string="Program">
                <header>
                    <button name="action_activate" string="Activate" type="object" class="oe_highlight"
                            invisible="state != 'draft'"
                            confirm="Activating this program will make it available for use across the system. Do you want to continue?"/>
                    <button name="action_close" string="Close" type="object"
                            invisible="state != 'active'"
                            confirm="Closing this program will finalize it and prevent further changes. Do you want to continue?"/>
                    <button name="action_reset_draft_wizard" string="Reset to Draft" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Health Program"/>
                        </h1>
                        <h3 class="text-muted mt-0">
                            <field name="code" class="oe_inline" placeholder="e.g. HEALTH"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Ownership">
                            <field name="manager_id" help="The person accountable for this program and its projects."/>
                        </group>
                        <group string="Company" groups="base.group_multi_company">
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Planned Cost" col="4">
                            <field name="currency_id" invisible="1"/>
                            <field name="budget_line_id" colspan="4"/>
                            <field name="planned_cost"/>
                            <field name="committed_amount"/>
                            <field name="actual_amount"/>
                            <field name="available_amount"/>
                        </group>
                    </group>
                    <separator string="Description"/>
                    <field name="description" nolabel="1" placeholder="Purpose and scope of this program…"/>
                    <separator string="Projects"/>
                    <field name="project_ids">
                        <tree decoration-muted="not active" decoration-info="state=='draft'"
                              decoration-success="state=='active'">
                            <field name="active" column_invisible="1"/>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="grant_id"/>
                            <field name="date_start" optional="show"/>
                            <field name="date_end" optional="show"/>
                            <field name="state" widget="badge"
                                   decoration-info="state=='draft'" decoration-success="state=='active'"
                                   decoration-muted="state=='closed'"/>
                        </tree>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_arcs_program_search" model="ir.ui.view">
        <field name="name">arcs.program.search</field>
        <field name="model">arcs.program</field>
        <field name="arch" type="xml">
            <search string="Search Programs">
                <field name="name" string="Program" filter_domain="['|',('name','ilike',self),('code','ilike',self)]"/>
                <field name="code"/>
                <field name="manager_id"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="active_state" string="Active" domain="[('state','=','active')]"/>
                <filter name="closed" string="Closed" domain="[('state','=','closed')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter name="g_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="g_manager" string="Manager" context="{'group_by':'manager_id'}"/>
                    <filter name="g_company" string="Company" context="{'group_by':'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
                <searchpanel>
                    <field name="state" icon="fa-flag" select="one" enable_counters="1"/>
                    <field name="manager_id" icon="fa-user" select="multi" enable_counters="1"/>
                    <field name="company_id" icon="fa-building" select="multi" enable_counters="1"
                           groups="base.group_multi_company"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="action_arcs_program" model="ir.actions.act_window">
        <field name="name">Programs</field>
        <field name="res_model">arcs.program</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_arcs_program_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first program</p>
            <p>Programs are the top level of your structure — projects and activities roll up under them.</p>
        </field>
    </record>

    <!-- ============================== PROJECT ============================== -->
    <record id="view_arcs_project_tree" model="ir.ui.view">
        <field name="name">arcs.project.tree</field>
        <field name="model">arcs.project</field>
        <field name="arch" type="xml">
            <tree string="Projects" decoration-muted="not active" decoration-info="state=='draft'"
                  decoration-success="state=='active'">
                <field name="active" column_invisible="1"/>
                <field name="code"/>
                <field name="name"/>
                <field name="program_id" optional="show"/>
                <field name="grant_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="manager_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state=='draft'" decoration-success="state=='active'"
                       decoration-muted="state=='closed'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>
    <record id="view_arcs_project_form" model="ir.ui.view">
        <field name="name">arcs.project.form</field>
        <field name="model">arcs.project</field>
        <field name="arch" type="xml">
            <form string="Project">
                <header>
                    <button name="action_activate" string="Activate" type="object" class="oe_highlight"
                            invisible="state != 'draft'"
                            confirm="Activating this project will make it available for use across the system. Do you want to continue?"/>
                    <button name="action_close" string="Close" type="object"
                            invisible="state != 'active'"
                            confirm="Closing this project will finalize it and prevent further changes. Do you want to continue?"/>
                    <button name="action_reset_draft_wizard" string="Reset to Draft" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Primary Healthcare 2026"/>
                        </h1>
                        <h3 class="text-muted mt-0">
                            <field name="code" class="oe_inline" placeholder="e.g. HEALTH-001"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="program_id" help="Optional program this project rolls up to."/>
                            <field name="grant_id" options="{'no_create': True}"
                                   help="The funding grant. The project's dates must fall inside the grant period."/>
                            <field name="manager_id"/>
                        </group>
                        <group string="Period">
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <group>
                        <group string="Planned Cost" col="4">
                            <field name="currency_id" invisible="1"/>
                            <field name="planned_cost"/>
                            <field name="committed_amount"/>
                            <field name="actual_amount"/>
                            <field name="available_amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Components" name="components">
                            <field name="component_ids">
                                <tree editable="bottom">
                                    <field name="name" placeholder="e.g. Outreach"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Activities" name="activities">
                            <field name="activity_ids">
                                <tree decoration-info="state=='draft'" decoration-warning="state=='submitted'"
                                      decoration-success="state in ('approved','implemented')"
                                      decoration-muted="state=='closed'">
                                    <field name="name"/>
                                    <field name="component_id" optional="show"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="planned_cost" sum="Planned"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_arcs_project_search" model="ir.ui.view">
        <field name="name">arcs.project.search</field>
        <field name="model">arcs.project</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Project" filter_domain="['|',('name','ilike',self),('code','ilike',self)]"/>
                <field name="code"/>
                <field name="program_id"/>
                <field name="grant_id"/>
                <field name="manager_id"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="active_state" string="Active" domain="[('state','=','active')]"/>
                <filter name="closed" string="Closed" domain="[('state','=','closed')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter name="g_program" string="Program" context="{'group_by':'program_id'}"/>
                    <filter name="g_grant" string="Grant" context="{'group_by':'grant_id'}"/>
                    <filter name="g_state" string="Status" context="{'group_by':'state'}"/>
                </group>
                <searchpanel>
                    <field name="state" string="Status" icon="fa-flag" enable_counters="1"/>
                    <field name="program_id" string="Program" icon="fa-folder" enable_counters="1" select="multi"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="action_arcs_project" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">arcs.project</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_arcs_project_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first project</p>
            <p>A project belongs to a grant and holds the components and activities you will implement.</p>
        </field>
    </record>

    <!-- ============================== ACTIVITY ============================== -->
    <record id="view_arcs_activity_tree" model="ir.ui.view">
        <field name="name">arcs.activity.tree</field>
        <field name="model">arcs.activity</field>
        <field name="arch" type="xml">
            <tree string="Activities"
                  decoration-info="state=='draft'" decoration-warning="state=='submitted'"
                  decoration-success="state in ('approved','implemented')" decoration-muted="state=='closed'">
                <field name="code" optional="hide"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="component_id" optional="hide"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="planned_cost" sum="Planned"/>
                <field name="state" widget="badge"
                       decoration-info="state=='draft'" decoration-warning="state=='submitted'"
                       decoration-success="state in ('approved','implemented')" decoration-muted="state=='closed'"/>
            </tree>
        </field>
    </record>
    <record id="view_arcs_activity_form" model="ir.ui.view">
        <field name="name">arcs.activity.form</field>
        <field name="model">arcs.activity</field>
        <field name="arch" type="xml">
            <form string="Activity">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight"
                            invisible="state!='draft'"
                            confirm="Submitting this activity will send it for approval and lock it from further edits. Do you want to continue?"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight"
                            invisible="state!='submitted'"
                            confirm="Approving this activity will commit its planned cost against the selected budget line. Do you want to continue?"/>
                    <button name="action_implement" string="Implement" type="object"
                            invisible="state!='approved'"
                            confirm="Marking this activity as implemented indicates execution has started and may restrict further changes to its plan. Do you want to continue?"/>
                    <button name="action_close" string="Close" type="object"
                            invisible="state!='implemented'"
                            confirm="Closing this activity will finalize it and prevent further changes. Do you want to continue?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,implemented,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Community vaccination drive"/>
                        </h1>
                        <h3 class="text-muted mt-0">
                            <field name="code" class="oe_inline" placeholder="optional code"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Linkage">
                            <field name="grant_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="component_id"
                                   help="Optional sub-component of the project this activity belongs to."/>
                            <field name="budget_line_id" options="{'no_create': True}"
                                   help="Budget line this activity is planned against; planned cost is checked against its available amount."/>
                        </group>
                        <group string="Plan">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="planned_cost"/>
                            <field name="expected_beneficiaries"/>
                        </group>
                    </group>
                    <group>
                        <group string="Tracking" col="4">
                            <field name="committed_amount"/>
                            <field name="actual_amount"/>
                            <field name="available_amount"/>
                        </group>
                    </group>
                    <separator string="Expected outputs"/>
                    <field name="expected_outputs" nolabel="1" placeholder="What this activity will deliver…"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_arcs_activity_search" model="ir.ui.view">
        <field name="name">arcs.activity.search</field>
        <field name="model">arcs.activity</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Activity" filter_domain="['|',('name','ilike',self),('code','ilike',self)]"/>
                <field name="project_id"/>
                <field name="component_id"/>
                <field name="budget_line_id"/>
                <field name="state"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="implemented" string="Implemented" domain="[('state','=','implemented')]"/>
                <group expand="0" string="Group By">
                    <filter name="g_project" string="Project" context="{'group_by':'project_id'}"/>
                    <filter name="g_comp" string="Component" context="{'group_by':'component_id'}"/>
                    <filter name="g_state" string="Status" context="{'group_by':'state'}"/>
                </group>
                <searchpanel>
                    <field name="state" string="Status" icon="fa-flag" enable_counters="1"/>
                    <field name="project_id" string="Project" icon="fa-folder" enable_counters="1" select="multi"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="action_arcs_activity" model="ir.actions.act_window">
        <field name="name">Activities</field>
        <field name="res_model">arcs.activity</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_arcs_activity_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Plan your first activity</p>
            <p>Activities are the costed, schedulable units of work inside a project, each tied to a budget line.</p>
        </field>
    </record>

</odoo>