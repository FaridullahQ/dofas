<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcit_about_config_settings" model="ir.ui.view">
        <field name="name">mcit.about.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mcit_base.view_mcit_config_settings"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='mcit_donor_management']" position="inside">
                <block title="About &amp; Help" name="mcit_about_block">
                    <setting string="About &amp; Help menu"
                             help="Show an 'About &amp; Help' menu with company info, the overall process flow and a glossary of terms.">
                        <field name="group_mcit_show_about"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
