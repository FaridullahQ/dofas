<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcit_faq_tree" model="ir.ui.view">
        <field name="name">mcit.faq.tree</field>
        <field name="model">mcit.faq</field>
        <field name="arch" type="xml">
            <tree string="FAQs" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="question"/>
            </tree>
        </field>
    </record>

    <record id="view_mcit_faq_form" model="ir.ui.view">
        <field name="name">mcit.faq.form</field>
        <field name="model">mcit.faq</field>
        <field name="arch" type="xml">
            <form string="FAQ">
                <sheet>
                    <group>
                        <field name="question"/>
                        <field name="answer"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mcit_faq" model="ir.actions.act_window">
        <field name="name">FAQs</field>
        <field name="res_model">mcit.faq</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
